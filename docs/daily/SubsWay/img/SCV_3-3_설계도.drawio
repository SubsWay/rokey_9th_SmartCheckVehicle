pace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="945" width="190" height="36" as="geometry"/></mxCell><mxCell id="exec:N:xs2" value="&lt;b&gt;_execute() → ⑧&lt;/b&gt;&lt;br&gt;REINSPECTION 실행" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="990" width="190" height="36" as="geometry"/></mxCell><mxCell id="exec:N:xs3" value="&lt;b&gt;_execute() → ⑧&lt;/b&gt;&lt;br&gt;FACILITY_CHECK 실행" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="1035" width="190" height="36" as="geometry"/></mxCell><mxCell id="exec:N:xs4" value="&lt;b&gt;_execute() → ⑧&lt;/b&gt;&lt;br&gt;DOCK 실행" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="1080" width="190" height="36" as="geometry"/></mxCell><mxCell id="exec:N:xs5" value="&lt;b&gt;_execute()&lt;/b&gt;&lt;br&gt;그 밖: UNKNOWN_TYPE 실패" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="1125" width="190" height="36" as="geometry"/></mxCell><mxCell id="exec:N:x11" value="cancel.is_set() ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="985" width="200" height="100" as="geometry"/></mxCell><mxCell id="exec:N:x12" value="&lt;b&gt;MissionExecutor._loop()&lt;/b&gt;&lt;br&gt;취소된 task — 결과 보내지 않음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="870" width="200" height="56" as="geometry"/></mxCell><mxCell id="exec:N:x13" value="go_dock ?" style="r