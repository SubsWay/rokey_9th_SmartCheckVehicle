ight="28" as="geometry"/></mxCell><mxCell id="status:M14" value="PostgreSQL 16 — scv_db (robotdb4_postgresql)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="78" y="1166" width="318" height="28" as="geometry"/></mxCell><mxCell id="status:N:r1" value="&lt;b&gt;tick_1hz()&lt;/b&gt;&lt;br&gt;배터리 · 도킹 상태를 1 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="100" y="135" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:r2" value="&lt;b&gt;tick_amcl()&lt;/b&gt;&lt;br&gt;initialpose 뒤 위치를 2 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="420" y="135" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:r3" value="&lt;b&gt;tick_rssi() [가상 세계]&lt;/b&gt;&lt;br&gt;현재 위치의 AP별 RSSI를 1 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="760" y="135" width="260" height="56" as="geometry"/></mxCell><mxCell id="status:N:c1" value="&lt;b&gt;_on_battery() · _on_dock()&lt;/b&gt;&lt;br&gt;배터리 · 도킹 최신값 저장" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:c2" value="&lt;b&gt;_on_amcl()&lt;/b&gt;&lt;br&gt;지도 좌표 위치 · 오차(σ) 최신값 저장" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:c3" value="&lt;b&gt;SurveyBuffer.on_rssi()&lt;/b&gt;&lt;br&gt;SSID별 마지막 수신 시각 기록&lt;br&gt;(순찰 표본 수집은 ⑦)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="260" height="56" as="geometry"/></mxCell><mxCell id="status:N:c4" value="&lt;b&gt;MissionExecutor.status()&lt;/b&gt;&lt;br&gt;최근 5 s 안의 위치 · 배터리 · 도킹으로&lt;br&gt;status 본문 생성 (nav_state 포함)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="status:N:c6" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;1 s마다 status를 WS로 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="980" y="447" width="200" height="56" as="geometry"/></mxCell><mxCell id="status:N:d1" value="&lt;b&gt;ws_agent()&lt;/b&gt;&lt;br&gt;받은 메시지가 status면 처리" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="960" y="670" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:d2" value="&lt;b&gt;store_status()&lt;/b&gt;&lt;br&gt;로봇 최신 상태를 메모리에 덮어씀" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="960" y="770" width="240" height="56" as="geometry"/></mxCell><mxCell id="status:N:d3" value="x · y · yaw · battery_pct&lt;br&gt;모두 있음?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="960" y="860" width="240" height="100" as="geometry"/></mxCell><mxCell id="status:N:d3n" value="메모리만" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="892" width="100" height="36" as="geometry"/></mxCell><mxCell id="status:N:d5" value="&lt;b&gt;mark_aps_seen()&lt;/b&gt;&lt;br&gt;status의 SSID와 같은 현재 지도&lt;br&gt;AP를 활성으로" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="670" width="210" height="56" as="geometry"/></mxCell><mxCell id="status:N:m1" value="&lt;b&gt;메모리 상태 (MEM_LOCK)&lt;/b&gt;&lt;br&gt;로봇 최신 상태 · 연결 · 마지막 응답 없음 ·&lt;br&gt;AP 수신 시각 · 최근 이벤트 · 진행 중 run" style="shape=internalStorage;dx=8;dy=0;fillColor=#EEF3E6;strokeColor=#6E8B3D;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="665" width="310" height="70" as="geometry"/></mxCell><mxCell id="status:N:u1" value="&lt;b&gt;ws_ui()&lt;/b&gt;&lt;br&gt;1 s마다 로봇 상태 · 진행 중 run의 최근&lt;br&gt;이벤트 30개 · 시작 조건을 화면에 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="820" width="310" height="70" as="geometry"/></mxCell><mxCell id="status:N:u2" value="&lt;b&gt;MonitorPage() · RobotPanel()&lt;/b&gt;&lt;br&gt;로봇 마커 · 상태(정상/끊김/응답 없음/비활성)&lt;br&gt;· 응답 없음까지 남은 초 · 순찰 시작 조건 표시" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="1010" width="310" height="70" as="geometry"/></mxCell><mxCell id="status:N:w1" value="lifespan → state_watchdog()" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="230" height="40" as="geometry"/></mxCell><mxCell id="status:N:w2" value="&lt;b&gt;state_watchdog()&lt;/b&gt;&lt;br&gt;1 s 대기 후 기준 시간(status_timeout_s)&lt;br&gt;읽기 · 만료 세션 삭제" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="45" y="735" width="262" height="56" as="geometry"/></mxCell><mxCell id="status:N:w3" value="로봇마다&lt;br&gt;now − rx &amp;gt; limit ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="825" width="230" height="100" as="geometry"/></mxCell><mxCell id="status:N:w4" value="&lt;b&gt;state_watchdog()&lt;/b&gt;&lt;br&gt;만료 로봇 상태를 지우고&lt;br&gt;record_e3() 호출" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="340" y="847" width="200" height="56" as="geometry"/></mxCell><mxCell id="status:N:w6" value="&lt;b&gt;on_robot_lost()&lt;/b&gt;&lt;br&gt;순찰 중이면 그 로봇 task 실패 처리" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="847" width="190" height="56" as="geometry"/></mxCell><mxCell id="status:N:w7" value="진행 중 run에 그 로봇&lt;br&gt;ACTIVE/PENDING task?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="590" y="940" width="210" height="100" as="geometry"/></mxCell><mxCell id="status:N:w8" value="&lt;b&gt;scv_fail_task() · close_if_done()&lt;/b&gt;&lt;br&gt;task 실패(NO_RESPONSE) · 남은 task&lt;br&gt;취소 → run 종료 확인 (⑤)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="580" y="1070" width="230" height="56" as="geometry"/></mxCell><mxCell id="status:N:w7n" value="끝" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="830" y="972" width="70" height="36" as="geometry"/></mxCell><mxCell id="status:N:w9" value="&lt;b&gt;expire_aps()&lt;/b&gt;&lt;br&gt;매 1 s 끊긴 AP를 비활성으로,&lt;br&gt;다음 1 s로" style="rounded=0;fillColor=#F6D2A2;s