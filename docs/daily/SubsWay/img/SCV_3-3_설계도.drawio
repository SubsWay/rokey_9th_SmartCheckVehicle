ze=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="170" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a4" value="&lt;b&gt;RosBridge.on_login()&lt;/b&gt;&lt;br&gt;세션 쿠키 발급 뒤 호출,&lt;br&gt;로봇 활성 확인을 바로 시작" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="260" y="500" width="170" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a5" value="&lt;b&gt;RosBridge._check_active()&lt;/b&gt;&lt;br&gt;0.2 s 타이머에서 토픽 목록 확인" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="170" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a6" value="/robot3/… 발행자 있음&lt;br&gt;&amp;amp; 꺼진 뒤 새 값?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="480" y="378" width="210" height="110" as="geometry"/></mxCell><mxCell id="conn:N:a7" value="&lt;b&gt;RosBridge._check_active()&lt;/b&gt;&lt;br&gt;로봇을 활성(active)으로&lt;br&gt;바꾸고 토픽 확인 중지" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="730" y="405" width="150" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a8" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;관제 PC /ws/agent에 접속" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="920" y="405" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a9" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;첫 메시지로 hello 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a10" value="첫 응답 welcome?&lt;br&gt;(5 s 안)" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1140" y="383" width="180" height="100" as="geometry"/></mxCell><mxCell id="conn:N:a11" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;1 s마다 status 전송 · 메시지 수신" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1360" y="405" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a12" value="&lt;b&gt;ScvAgent.on_message()&lt;/b&gt;&lt;br&gt;config(지도 · 도크 자세) 저장" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a13" value="dock_pose 있음 &amp;amp;&lt;br&gt;(도킹·task 없음&lt;br&gt;또는 위치 모름)?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1580" y="495" width="200" height="120" as="geometry"/></mxCell><mxCell id="conn:N:a14" value="&lt;b&gt;RosBridge.set_initial_pose()&lt;/b&gt;&lt;br&gt;도크 접근 자세를 시작 위치로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1590" y="375" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:a13n" value="건너뜀" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1800" y="537" width="60" height="36" as="geometry"/></mxCell><mxCell id="conn:N:a15" value="&lt;b&gt;RosBridge._tick()&lt;/b&gt;&lt;br&gt;로봇 값이 5 s 넘게 없으면&lt;br&gt;비활성으로 바꾸고 확인 재시작" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="470" y="565" width="210" height="60" as="geometry"/></mxCell><mxCell id="conn:N:a16" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;로봇 비활성 → 관제 PC 연결을&lt;br&gt;정상 종료(1000)로 닫음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="700" y="565" width="200" height="60" as="geometry"/></mxCell><mxCell id="conn:N:b1" value="&lt;b&gt;client_login()&lt;/b&gt;&lt;br&gt;client page 로그인 요청을 받음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="200" height="56" as="geometry"/></mxCell><mxCell id="conn:N:b2" value="users: crypt(pw, hash)&lt;br&gt;일치? (빈 값 400)" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="200" height="100" as="geometry"/></mxCell><mxCell id="conn:N:b3" value="401 거부" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="95" y="1005" width="130" height="36" as="geometry"/></mxCell><mxCell id="conn:N:b4" value="&lt;b&gt;ws_agent()&lt;/b&gt;&lt;br&gt;제어 PC의 WS 연결을 받음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="920" y="790" width="180" height="56" as="geometry"/></mxCell><mxCell id="conn:N:b5" value="10 s 안 첫 메시지&lt;br&gt;= hello &amp;amp; robot_id?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="920" y="880" width="180" height="100" as="geometry"/></mxCell><mxCell id="conn:N:b5n" value="close(4400)" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;htm