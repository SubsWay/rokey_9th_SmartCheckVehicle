eometry x="110" y="430" width="240" height="56" as="geometry"/></mxCell><mxCell id="survey:N:v3" value="&lt;b&gt;MissionExecutor._drive() (⑥)&lt;/b&gt;&lt;br&gt;도크 이탈 후 경로점 주행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="240" height="56" as="geometry"/></mxCell><mxCell id="survey:N:v4" value="&lt;b&gt;SurveyBuffer.flush()&lt;/b&gt;&lt;br&gt;수집을 끝내고 남은 표본 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="110" y="610" width="240" height="56" as="geometry"/></mxCell><mxCell id="survey:N:v5" value="&lt;b&gt;SurveyBuffer.find_candidates()&lt;/b&gt;&lt;br&gt;칸마다 후보인지 확인&lt;br&gt;(이미 보고한 칸 제외)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="110" y="700" width="240" height="56" as="geometry"/></mxCell><mxCell id="survey:N:v6" value="candidate_rule (칸마다)&lt;br&gt;표본 ≥ min_samples인 AP 중&lt;br&gt;최대 중앙값 &amp;lt; rssi_suspect_dbm ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="280" height="140" as="geometry"/></mxCell><mxCell id="survey:N:v7" value="&lt;b&gt;MissionExecutor._execute()&lt;/b&gt;&lt;br&gt;후보 칸을 기록하고 CANDIDATE&lt;br&gt;이벤트 전송 (후보 ID · 칸 ·&lt;br&gt;재방문 지점 · 점수 · 중앙값)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="90" y="985" width="330" height="90" as="geometry"/></mxCell><mxCell id="survey:N:v8" value="&lt;b&gt;MissionExecutor._execute()&lt;/b&gt;&lt;br&gt;결과 (ok, 사유) 반환 → ⑥" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="440" y="712" width="190" height="56" as="geometry"/></mxCell><mxCell id="survey:N:w1" value="&lt;b&gt;RosBridge._on_rssi()&lt;/b&gt;&lt;br&gt;rssi 값을 SurveyBuffer로 넘김" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="830" y="360" width="230" height="50" as="geometry"/></mxCell><mxCell id="survey:N:w2" value="&lt;b&gt;SurveyBuffer.on_rssi()&lt;/b&gt;&lt;br&gt;SSID별 마지막 수신 시각 기록 (③)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="830" y="440" width="230" height="56" as="geometry"/></mxCell><mxCell id="survey:N:w3" value="정밀측정 중?&lt;br&gt;(precise ≠ None)" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="830" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="survey:N:w3y" value="&lt;b&gt;SurveyBuffer.on_rssi()&lt;/b&gt;&lt;br&gt;정밀측정 중: 측정 AP 값만 모으고&lt;br&gt;끝냄 (⑧)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1110" y="537" width="290" height="56" as="geometry"/></mxCell><mxCell id="survey:N:w4" value="cfg(run_config) 있음 &amp;amp;&lt;br&gt;collect_task 있음?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="830" y="640" width="230" height="90" as="geometry"/></mxCell><mxCell id="survey:N:w4n" value="return" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1110" y="667" width="90" height="36" as="geometry"/></mxCell><mxCell id="survey:N:w5" value="info[&amp;#x27;pose&amp;#x27;] 있음 &amp;amp;&lt;br&gt;나이 ≤ STALE_S(5 s)?" style="rhombus;fillColor=#F6D2A