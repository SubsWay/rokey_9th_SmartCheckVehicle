" value="(False, UNDOCK_FAILED · CANCELED)" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1100" y="327" width="260" height="36" as="geometry"/></mxCell><mxCell id="exec:N:y4" value="&lt;b&gt;MissionExecutor._event()&lt;/b&gt;&lt;br&gt;UNDOCK 이벤트 기록" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="840" y="420" width="200" height="44" as="geometry"/></mxCell><mxCell id="exec:N:y5" value="&lt;b&gt;RosBridge.navigate()&lt;/b&gt;&lt;br&gt;경로점을 차례로 주행 (Nav2 액션)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="280" height="56" as="geometry"/></mxCell><mxCell id="exec:N:y6" value="&lt;b&gt;stop() 콜백&lt;/b&gt;&lt;br&gt;0.05 s마다 확인: 배터리 부족 · 취소면&lt;br&gt;주행 중단, 1 s마다 표본 · 진행률 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="930" y="600" width="290" height="86" as="geometry"/></mxCell><mxCell id="exec:N:y7" value="결과 ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="180" height="100" as="geometry"/></mxCell><mxCell id="exec:N:o1" value="&lt;b&gt;_drive()&lt;/b&gt;&lt;br&gt;배터리 부족 이벤트 · 실패" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="570" y="770" width="180" height="50" as="geometry"/></mxCell><mxCell id="exec:N:o2" value="&lt;b&gt;_drive()&lt;/b&gt;&lt;br&gt;주행 성공" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="765" y="770" width="150" height="50" as="geometry"/></mxCell><mxCell id="exec:N:o3" value="&lt;b&gt;_drive()&lt;/b&gt;&lt;br&gt;취소됨 (CANCELED)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="930" y="770" width="150" height="50" as="geometry"/></mxCell><mxCell id="exec:N:o4" value="&lt;b&gt;_drive()&lt;/b&gt;&lt;br&gt;Nav2 없음 (NO_NAV2)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1095" y="770" width="150" height="50" as="geometry"/></mxCell><mxCell id="exec:N:o5" value="&lt;b&gt;_drive()&lt;/b&gt;&lt;br&gt;막힘 이벤트 · 실패" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="770" width="170" height="50" as="geometry"/></mxCell><mxCell id="exec:N:z1" value="&lt;b&gt;_return_home()&lt;/b&gt;&lt;br&gt;도크 자세 찾기: 순찰 설정 →&lt;br&gt;중단 때 보관값 → 관제 PC config" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="915" width="320" height="56" as="geometry"/></mxCell><mxCell id="exec:N:z2" value="dock 있음 &amp;amp;&lt;br&gt;도킹 아님?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="995" width="220" height="90" as="geometry"/></mxCell><mxCell id="exec:N:z3" value="&lt;b&gt;_return_home()&lt;/b&gt;&lt;br&gt;도크로 주행한 뒤 도킹&lt;br&gt;(취소할 수 없음)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="1120" width="320" height="70" as="geometry"/></mxCell><mxCell id="exec:N:R1" value="&lt;b&gt;exec_undock()&lt;/b&gt;&lt;br&gt;도크에서 25 cm 뒤로 나옴&lt;br&gt;(위치를 모르면 실패)" style="rounded=0;fillColor=#F6D2A2;strok