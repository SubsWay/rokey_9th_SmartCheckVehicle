<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="sys" name="① 시스템 구성 · 모듈 간 인터페이스 (SCV 3-3차 — scv_app · scv_db)"><mxGraphModel dx="1900" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1090" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys:M1" value="&lt;b&gt;① 시스템 구성 · 모듈 간 인터페이스 (SCV 3-3차 — scv_app · scv_db)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1860" height="28" as="geometry"/></mxCell><mxCell id="sys:M2" value="ROBOT(robot3_virtual) ─ROS 2─ PC2 제어 PC(client_page) ─HTTP · WebSocket─ PC1 관제 PC(server_page) ─ PostgreSQL. 화살표 색: 검정 ROS · 빨강 PC 간 메시지 · 주황 함수 호출" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1860" height="20" as="geometry"/></mxCell><mxCell id="sys:M3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2B4BE0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="340" height="950" as="geometry"/></mxCell><mxCell id="sys:M4" value="&lt;b&gt;ROBOT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B4BE0;strokeWidth=3;fontColor=#C0392B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="72" height="28" as="geometry"/></mxCell><mxCell id="sys:M5" value="robot3_virtual.py" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="108" y="66" width="134" height="28" as="geometry"/></mxCell><mxCell id="sys:M6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2B4BE0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="680" height="950" as="geometry"/></mxCell><mxCell id="sys:M7" value="&lt;b&gt;PC2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B4BE0;strokeWidth=3;fontColor=#C0392B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="450" y="66" width="50" height="28" as="geometry"/></mxCell><mxCell id="sys:M8" value="제어 PC — client_page.py (:8080)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="506" y="66" width="233" height="28" as="geometry"/></mxCell><mxCell id="sys:M9" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2B4BE0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="660" height="950" as="geometry"/></mxCell><mxCell id="sys:M10" value="&lt;b&gt;PC1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B4BE0;strokeWidth=3;fontColor=#C0392B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1210" y="66" width="50" height="28" as="geometry"/></mxCell><mxCell id="sys:M11" value="관제 PC — server_page.py (:8000)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1266" y="66" width="233" height="28" as="geometry"/></mxCell><mxCell id="sys:N:r1" value="&lt;b&gt;tick_1hz() · tick_odom()&lt;/b&gt;&lt;br&gt;배터리 · 도킹 상태(1 Hz), odom(10 Hz),&lt;br&gt;IP(1 Hz) 토픽 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="270" height="66" as="geometry"/></mxCell><mxCell id="sys:N:r2" value="&lt;b&gt;tick_amcl()&lt;/b&gt;&lt;br&gt;initialpose를 받은 뒤 지도 좌표 위치를&lt;br&gt;2 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="250" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:r3" value="&lt;b&gt;on_initialpose()&lt;/b&gt;&lt;br&gt;받은 자세를 현재 위치 · 도크 위치로 삼음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="350" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:r4" value="&lt;b&gt;tick_rssi() [가상 세계]&lt;/b&gt;&lt;br&gt;현재 위치의 AP별 RSSI를 1 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="450" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:r5" value="&lt;b&gt;exec_nav() · exec_undock() · exec_dock()&lt;/b&gt;&lt;br&gt;주행 · 도크 이탈 · 도킹 액션 수행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="560" width="270" height="66" as="geometry"/></mxCell><mxCell id="sys:N:r6" value="&lt;b&gt;on_detect_request() [가상 판정]&lt;/b&gt;&lt;br&gt;truth 정답으로 판정하고 판정 사진을 띄움" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="680" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:r7" value="&lt;b&gt;tick_camera()&lt;/b&gt;&lt;br&gt;카메라 JPEG를 10 Hz로 발행" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="790" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:rw" value="&lt;b&gt;world.yaml truth&lt;/b&gt;&lt;br&gt;가상 세계 정답: AP 모델 · 벽 감쇠 ·&lt;br&gt;음영 구역 · 설비 실제 상태" style="shape=internalStorage;dx=8;dy=0;fillColor=#EEF3E6;strokeColor=#6E8B3D;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="270" height="56" as="geometry"/></mxCell><mxCell id="sys:N:RB" value="&lt;b&gt;RosBridge&lt;/b&gt;&lt;br&gt;로봇과의 ROS 통신&lt;br&gt;(ros-spin 스레드)&lt;br&gt;&lt;br&gt;로봇 토픽 구독,&lt;br&gt;initialpose 발행,&lt;br&gt;주행 · 도킹 액션 요청" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="170" height="716" as="geometry"/></mxCell><mxCell id="sys:N:CU" value="&lt;b&gt;LoginPage() → login()&lt;/b&gt;&lt;br&gt;브라우저 로그인 요청을 받아&lt;br&gt;관제 PC에 계정 확인" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="200" height="56" as="geometry"/></mxCell><mxCell id="sys:N:AG" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;관제 PC WS에 접속해 hello 전송,&lt;br&gt;1 s마다 status 전송 · 명령 수신" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="200" height="70" as="geometry"/></mxCell><mxCell id="sys:N:ME" value="&lt;b&gt;MissionExecutor._loop()&lt;/b&gt;&lt;br&gt;받은 task를 하나씩 실행하고&lt;br&gt;1 s마다 status 본문을 만듦" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="200" height="70" as="geometry"/></mxCell><mxCell id="sys:N:SB" value="&lt;b&gt;SurveyBuffer.on_rssi()&lt;/b&gt;&lt;br&gt;RSSI 표본 수집 · 칸 후보 · 정밀측정" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="620" width="200" height="56" as="geometry"/></mxCell><mxCell id="sys:N:DA" value="&lt;b&gt;DetectionAlert.inspect()&lt;/b&gt;&lt;br&gt;설비 판정 1회와 사진 촬영" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="770" width="200" height="56" as="geometry"/></mxCell><mxCell id="sys:N:OB" value="&lt;b&gt;Outbox._loop()&lt;/b&gt;&lt;br&gt;쌓인 기록을 순서대로&lt;br&gt;관제 PC로 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="965" y="600" width="145" height="70" as="geometry"/></mxCell><mxCell id="sys:N:OBf" value="&lt;b&gt;outbox_{robot}/&lt;/b&gt;&lt;br&gt;보낼 기록 · 사진 ·&lt;br&gt;실패 파일 · run별 번호" style="shape=internalStorage;dx=8;dy=0;fillColor=#EEF3E6;strokeColor=#6E8B3D;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="965" y="720" width="145" height="66" as="geometry"/></mxCell><mxCell id="sys:N:CL" value="&lt;b&gt;client_login()&lt;/b&gt;&lt;br&gt;client page 계정을 DB로 확인" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="230" height="56" as="geometry"/></mxCell><mxCell id="sys:N:WA" value="&lt;b&gt;ws_agent()&lt;/b&gt;&lt;br&gt;로봇 1대당 WS 연결 하나를 받아&lt;br&gt;hello · status · task 메시지 처리" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="250" width="230" height="70" as="geometry"/></mxCell><mxCell id="sys:N:IM" value="&lt;b&gt;start_run() · on_task_result()&lt;/b&gt;&lt;br&gt;순찰 run · task 생성과 배정,&lt;br&gt;결과에 따른 다음 단계 · run 종료" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="230" height="70" as="geometry"/></mxCell><mxCell id="sys:N:RA" value="&lt;b&gt;on_samples() · on_events() 등&lt;/b&gt;&lt;br&gt;제어 PC 아웃박스 기록(표본 · 이벤트 ·&lt;br&gt;판정 · 사진 · 결과)을 DB에 저장" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="230" height="70" as="geometry"/></mxCell><mxCell id="sys:N:WD" value="&lt;b&gt;state_watchdog()&lt;/b&gt;&lt;br&gt;1 s마다 응답 없는 로봇 처리,&lt;br&gt;끊긴 AP 비활성 · 만료 세션 삭제" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="140" width="320" height="56" as="geometry"/></mxCell><mxCell id="sys:N:MM" value="&lt;b&gt;메모리 상태 (MEM_LOCK)&lt;/b&gt;&lt;br&gt;세션 · 로봇 최신 상태 · 연결 · 진행 중 run ·&lt;br&gt;최근 이벤트 · 히트맵 · AP 수신 시각" style="shape=internalStorage;dx=8;dy=0;fillColor=#EEF3E6;strokeColor=#6E8B3D;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="250" width="320" height="70" as="geometry"/></mxCell><mxCell id="sys:N:UW" value="&lt;b&gt;ws_ui()&lt;/b&gt;&lt;br&gt;1 s마다 로봇 상태 · 이벤트 · 시작 조건을&lt;br&gt;모니터 화면으로 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="420" width="320" height="56" as="geometry"/></mxCell><mxCell id="sys:N:SP" value="&lt;b&gt;App() — server page (브라우저)&lt;/b&gt;&lt;br&gt;admin 로그인 · 모니터 · 이력 · 정보 탭" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="590" width="320" height="56" as="geometry"/></mxCell><mxCell id="sys:N:MA" value="&lt;b&gt;api_run_start() · api_run_abort() 등&lt;/b&gt;&lt;br&gt;순찰 시작 · 중단, 이력 조회,&lt;br&gt;정보 탭 CRUD API" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1530" y="700" width="320" height="56" as="geometry"/></mxCell><mxCell id="sys:N:DB" value="&lt;b&gt;PostgreSQL 16 (robotdb4_postgresql)&lt;/b&gt;&lt;br&gt;20개 표 · 규칙 트리거 · 실패/종료 함수&lt;br&gt;(scv_fail_task · scv_close_run · scv_abort_run)&lt;br&gt;쓰기는 관제 PC만" style="shape=cylinder3;boundedLbl=1;size=9;fillColor=#E6ECF8;strokeColor=#4A63B8;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="830" width="610" height="110" as="geometry"/></mxCell><mxCell id="sys:N:MF" value="&lt;b&gt;SCV_MEDIA_DIR&lt;/b&gt;&lt;br&gt;지도 PNG · 판정 사진 파일 저장" style="shape=internalStorage;dx=8;dy=0;fillColor=#EEF3E