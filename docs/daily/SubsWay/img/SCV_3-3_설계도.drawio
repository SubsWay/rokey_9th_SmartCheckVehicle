olor=#FFFFFF;fontStyle=1;fontSize=10;strokeColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1340" y="990" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="iface" name="⑪ 메시지 인터페이스 정의 (WebSocket · REST · ROS 2 · 이벤트 코드)"><mxGraphModel dx="1900" dy="1888" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1888" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="iface:M1" value="&lt;b&gt;⑪ 메시지 인터페이스 정의 (WebSocket · REST · ROS 2 · 이벤트 코드)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1860" height="28" as="geometry"/></mxCell><mxCell id="iface:M2" value="코드에서 그대로 옮긴 필드 — server_page.py envelope/send_agent · client_page.py ScvAgent/Outbox/RosBridge · robot3_virtual.py" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1860" height="20" as="geometry"/></mxCell><mxCell id="iface:H0" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;WebSocket /ws/agent — PC2 → PC1 (제어 PC가 보냄)&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;틀 {type, msg_id, ts(UTC ISO ms, Z), body} · msg_id: hello c-000001 · status c-s00000001 · 그 밖 c-m00000001&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;type&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;보내는 때&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;body&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;PC1 처리&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;hello&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;연결 첫 메시지 (PC1은 10 s 안에 기다림)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;robot_id, agent_version &amp;quot;3-3&amp;quot;, run_id, active_task_id, outbox_pending&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;set_robot_active(true) · AGENTS 등록 → welcome · config · agent_resync&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;status&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;1 s마다 (STATUS_PERIOD_S)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;stamp, robot_id, run_id, task_id, nav_state, progress, x, y, yaw, battery_pct, is_docked, estop, ssids[]&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;store_status → ROBOT_STATE · robot_status_log / mark_aps_seen → aps.is_active&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;task_progress&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;주행 중 1 s · 정밀측정 중 1 s&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task_id, progress (0~1)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_task_progress → tasks.progress (ACTIVE만)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;task_accepted&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;_execute 시작 (지도 파일 확인 뒤)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task_id&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;로그만&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;task_rejected&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task 지도 파일이 제어 PC에 없음&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task_id, reason = MAP_MISMATCH&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_task_result(ok = False)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1840" height="184" as="geometry"/></mxCell><mxCell id="iface:H1" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;WebSocket /ws/agent — PC1 → PC2 (관제 PC가 보냄)&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;msg_id s-000001 · 닫기 코드: 4400 첫 메시지가 hello 아님 · 4404 등록 안 된 로봇 · 4409 같은 로봇 새 연결 · 1000 robot inactive(client가 닫음)&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;type&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;보내는 때&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;body&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;PC2 처리&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;welcome&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;hello 직후&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;server_time, run, active_task_id&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;connected (첫 응답이 welcome이 아니면 재접속)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;config&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;연결 · 현재 지도 변경 · 도크 수정 (push_config)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;map {map_id, name, robot_map_path} | null, dock_pose {x, y, yaw} | null&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;도킹 · task 없음 또는 위치 모름 → set_initial_pose&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;run_config&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;순찰 시작 · 재접속(agent_resync)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;run_id, map, grid {origin_x, origin_y, size}, sectors[], sector_cells[[cell_id, ix, iy]], ssids[측정 AP], target_ap {ssid, x, y}, facilities[], settings {rssi_suspect_dbm, min_samples, precise_duration_s, max_pose_retry, battery_return_pct}, dock_pose&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_run_config → SurveyBuffer.configure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;task_assign&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;다음 task ACTIVE · 재접속&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;run_id, task_id, type, target_ref, waypoints[{x, y, yaw}], map_path (+ facility | candidate)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_task_assign → q.put (같은 task_id면 무시)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;task_cancel&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;재접속 때 하던 task가 DB ACTIVE 아님&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task_id, reason = NOT_ACTIVE, go_dock (DB ACTIVE 없으면 true)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_task_cancel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;run_cancel&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;순찰 중단 abort_run&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;run_id, reason = ADMIN_STOP, go_dock = true&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_run_cancel → 도크 복귀&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;run_end&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;scv_close_run이 run을 닫음&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;run_id, status (done | partial | aborted)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_run_end (순찰 표시 끝)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;error&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;등록 안 된 robot_id&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;reason = UNKNOWN_ROBOT, robot_id&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;연결 실패 → backoff 재접속&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="294" width="1840" height="256" as="geometry"/></mxCell><mxCell id="iface:H2" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;HTTP — PC2 → PC1 (Outbox · 로그인 · seq)&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;/api/agent/*는 로그인 확인 없음, body에 robot_id. 2xx면 아웃박스에서 지움 · 409 · 5xx · 연결 실패는 다시 · 그 밖 4xx는 failed/&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;메서드 · 경로&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;body&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;응답&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;저장 · 중복 무시 키&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/client/login&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{username, password}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{user: {user_id, username, role}} · 400 · 401&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;users crypt 확인 (세션 없음)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/samples&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{robot_id, run_id, samples[{seq, stamp, x, y, yaw, pose_ok, ssid, rssi_dbm, task_id}]}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, stored, dropped}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;net_samples PK (robot_id, run_id, seq) · LIVE_CELLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/events&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{robot_id, events[{event_uid, run_id, task_id, code, source, level, detail, ts}]}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, stored, rejected[]}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;robot_events UK event_uid → candidates · findings&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/precise-measures&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{robot_id, task_id, cell_id, measures[{ssid, duration_s, n_samples, rssi_median, rssi_iqr, measured_at}]}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, stored} (없는 task면 stored 0)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;precise_measures UK (task_id, ap_id)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/inspections&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{robot_id, inspection_uid, task_id, facility_id, detail, final, frontal, pose_retry, gauge_state, confidence, bbox, model_version, inspected_at}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, inspection_id}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;inspections UK inspection_uid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/media&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;multipart: meta {robot_id, inspection_uid, index, kind, captured_at} + file (jpg)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, object_key} · 409 판정 아직 없음&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;media UK object_key + 파일&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/agent/tasks/{task_id}/result&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{robot_id, ok, reason, ended_at}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{ok, next, run_status}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;on_task_result (⑤)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;GET /api/agent/last-seq&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;?robot_id &amp;amp; run_id&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{last_seq}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;SurveyBuffer.configure — seq 이어 쓰기&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1840" height="256" as="geometry"/></mxCell><mxCell id="iface:H3" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;ROS 2 — ROBOT ↔ PC2 (이름공간 /robot3)&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;client 로봇 정보 · 카메라 구독은 sensor_data(best effort), virtual/detect_result는 depth 10 · 가상 로봇 발행은 카메라만 best effort, 나머지 reliable depth 10&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;이름&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;타입&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;방향 · 주기&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;내용&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;battery_state&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;sensor_msgs/BatteryState&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 1 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;percentage → battery_pct · battery_return_pct 판단&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;dock_status&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;irobot_create_msgs/DockStatus&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 1 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;is_docked → status · undock/DOCK 판단&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;odom&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;nav_msgs/Odometry&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 10 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;화면 표시 · 활성(값 끊김) 판정&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;amcl_pose&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;geometry_msgs/PoseWithCovarianceStamped&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 2 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;x, y, yaw, sigma_xy → status · 표본 위치 (pose_ok: σ ≤ 0.25 m &amp;amp; 나이 ≤ 1.5 s)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;ip&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;std_msgs/String&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 1 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;화면 표시&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;rssi&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;std_msgs/String (JSON)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 1 Hz (--rssi-hz)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{stamp, scans[{ssid, rssi_dbm}]} → SurveyBuffer.on_rssi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;oakd/rgb/image_raw/compressed&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;sensor_msgs/CompressedImage&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2 · 10 Hz&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;카메라 탭 · 순찰 중 · 판정 사진 캡처 때만 구독&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;initialpose&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;geometry_msgs/PoseWithCovarianceStamped&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;PC2 → ROBOT · config 받을 때&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;도크 접근 자세 (σ 5 cm · 3°)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;virtual/detect_request&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;std_msgs/String (JSON)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;PC2 → ROBOT · 판정마다&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{request_id, facility_id, facility_type, has_gauge, expected_x, expected_y}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;virtual/detect_result&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;std_msgs/String (JSON)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ROBOT → PC2&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{request_id, facility_id, frontal, occluded, detections[{class, x, y, conf, bbox, state, gauge}]}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;navigate_through_poses&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;nav2_msgs/NavigateThroughPoses (action)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;PC2 → ROBOT&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;goal poses[PoseStamped map] · feedback number_of_poses_remaining&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;undock · dock&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;irobot_create_msgs/Undock · Dock (action)&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;PC2 → ROBOT&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;대기 60 s · 120 s · 결과 SUCCEEDED / CANCELED / ABORTED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="866" width="1840" height="352" as="geometry"/></mxCell><mxCell id="iface:H4" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;robot_events 코드 · 식별자&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;event_uid = {robot}-r{run}-e{NNNNNN} (PC2) · control-&amp;lt;uuid&amp;gt; (PC1 응답 없음) · task_id = r{run}-t{NNN} · candidate_id = r{run}-{robot}-c{NN}&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;code&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;level · source&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;detail&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;내는 곳&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;UNDOCK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;info · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{x, y}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;_drive (도킹 중이면 undock 성공 뒤)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;DOCK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;info · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;DOCK task dock 성공&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;CANDIDATE&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;warn · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{candidate_id, source NETWORK, kind NET_COVERAGE, ref cell_id, target [x, y], score, medians}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;SURVEY_SEGMENT 끝 find_candidates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;CONFIRMED · CLEARED · UNCONFIRMED&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;error · info · info&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{candidate_id, best_median, medians}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;REINSPECTION 정밀측정 결론&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;막힘 (DB 값 E1)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;warn · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{x, y}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;navigate 실패 → BLOCKED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;배터리 부족 (DB 값 E2)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;warn · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{battery_pct}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;battery ≤ battery_return_pct → BATTERY_LOW&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;정면 확보 실패 (DB 값 E6)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;warn · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{facility_id, pose_retry}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;max_pose_retry 넘어도 OCCLUDED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;MAP_MISMATCH&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;error · robot&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{map_path}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task 지도 파일 없음&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;응답 없음 (DB 값 E3)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;warn · control&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{reason NO_STATUS, timeout_s, agent_connected}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;state_watchdog (status_timeout_s 동안 status 없음)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1248" width="1840" height="280" as="geometry"/></mxCell><mxCell id="iface:H5" value="&lt;div style=&quot;font-weight:700;font-size:13px;color:#C0392B&quot;&gt;PC1 ↔ server page (브라우저)&lt;/div&gt;&lt;div style=&quot;color:#555;margin:2px 0 4px&quot;&gt;로그인 세션 쿠키 scv_session (메모리 8 h) · /ws/ui는 연결 때만 쿠키 확인&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;경로&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;용도&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;body · 응답&lt;/th&gt;&lt;th style=&quot;font-size:11px;border:1px solid #B98A57;background:#F6D2A2;padding:3px 5px;text-align:left;font-weight:700&quot;&gt;처리 함수&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;WS /ws/ui (1 s)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;모니터 실시간&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{type robots, ts, timeout_s, robots[{robot_id, is_active, connected, state{… ttl_s, raw}, last_e3}], run_id, events[30], aps[], start{can_start, problems, running, target_ap, robots}}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;ws_ui · robots_snapshot · ui_extra&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;GET /api/runs/form&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;순찰 시작 창&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{map, sectors, robots[{robot_id, ready, why}], target_ap, problems, can_start, default, run_types, running}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;start_form&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/runs&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;순찰 시작&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;{sector_robots {섹터: robot}, run_type?} → {ok, run_id}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;start_run&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;POST /api/runs/{id}/abort&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;순찰 중단&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;→ {ok, canceled}&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;abort_run(ADMIN_STOP)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;GET /api/runs · /api/runs/{id} · /events&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;이력 탭&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;run 목록 · run 상세(tasks, candidates, inspections, heat) · 이벤트&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;api_runs · api_run_detail&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;GET /api/tasks/{task_id}&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;이력 「자세히」&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;task · plan_cells · visits · track · survey / precise / inspections&lt;/td&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;api_task_detail&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-size:11px;border:1px solid #D9C2A4;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;/api/maps/upload · /{id}/activate · /{id}/grid&lt;/b&gt;&lt;/td&