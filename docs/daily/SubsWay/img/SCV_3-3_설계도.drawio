=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="425" width="240" height="56" as="geometry"/></mxCell><mxCell id="insp:N:g3" value="&lt;b&gt;SurveyBuffer.measure()&lt;/b&gt;&lt;br&gt;별도 스레드에서 정지 측정&lt;br&gt;(precise_duration_s), 1 s마다 진행률" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="260" height="66" as="geometry"/></mxCell><mxCell id="insp:N:g4" value="cancel ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="160" height="80" as="geometry"/></mxCell><mxCell id="insp:N:g4y" value="(False, CANCELED)" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="285" y="632" width="160" height="36" as="geometry"/></mxCell><mxCell id="insp:N:g5" value="&lt;b&gt;MissionExecutor._execute()&lt;/b&gt;&lt;br&gt;SSID별 중앙값 · IQR 계산,&lt;br&gt;값이 있으면 precise-measures 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="270" height="66" as="geometry"/></mxCell><mxCell id="insp:N:g6" value="best = 측정 SSID&lt;br&gt;최대 중앙값 ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="240" height="100" as="geometry"/></mxCell><mxCell id="insp:N:gU" value="&lt;b&gt;_event(UNCONFIRMED)&lt;/b&gt;&lt;br&gt;측정값 없음 (info)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="965" width="150" height="56" as="geometry"/></mxCell><mxCell id="insp:N:gC" value="&lt;b&gt;_event(CONFIRMED)&lt;/b&gt;&lt;br&gt;기준 미만 — 확정 (error)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="220" y="965" width="150" height="56" as="geometry"/></mxCell><mxCell id="insp:N:gL" value="&lt;b&gt;_event(CLEARED)&lt;/b&gt;&lt;br&gt;기준 이상 — 해소 (info)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="380" y="965" width="150" height="56" as="geometry"/></mxCell><mxCell id="insp:N:h1" value="&lt;b&gt;MissionExecutor._execute() (⑥)&lt;/b&gt;&lt;br&gt;type이 FACILITY_CHECK" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="240" height="40" as="geometry"/></mxCell><mxCell id="insp:N:h2" value="&lt;b&gt;MissionExecutor._drive()&lt;/b&gt;&lt;br&gt;관측 자세로 이동 (실패면 끝)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="425" width="240" height="56" as="geometry"/></mxCell><mxCell id="insp:N:h3" value="&lt;b&gt;DetectionAlert.inspect()&lt;/b&gt;&lt;br&gt;설비 판정 1회 (가림이면 재관측)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="510" width="300" height="56" as="geometry"/></mxCell><mxCell id="insp:N:h4" value="&lt;b&gt;RosBridge.virtual_detect()&lt;/b&gt;&lt;br&gt;가상 판정 요청을 보내고&lt;br&gt;결과를 3 s까지 기다림" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="600" width="300" height="66" as="geometry"/></mxCell><mxCell id="insp:N:h5" value="&lt;b&gt;judge()&lt;/b&gt;&lt;br&gt;검출 결과로 판정" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="700" width="240" height="44" as="geometry"/></mxCell><mxCell id="insp:N:h5r" value="&lt;b&gt;judge() 판정 규칙 (임시 — 4차 교체)&lt;/b&gt;&lt;br&gt;결과 없음 → NOT_DETECTED · 미확인&lt;br&gt;가림 · 정면 아님 → OCCLUDED · 미확인&lt;br&gt;같은 종류 검출 없음 → NOT_DETECTED · 이상&lt;br&gt;위치 차 0.5 m 초과 → POSITION_ANOMALY · 이상&lt;br&gt;상태 · 압력계 이상 → ABNORMAL · 이상&lt;br&gt;그 밖 → NORMAL · 정상" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="990" y="700" width="270" height="124" as="geometry"/></mxCell><mxCell id="insp:N:h6" value="OCCLUDED &amp;amp;&lt;br&gt;retry &amp;lt; max_pose_retry&lt;br&gt;&amp;amp; 취소 아님?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="775" width="240" height="100" as="geometry"/></mxCell><mxCell id="insp:N:h7" value="&lt;b&gt;RosBridge.capture_jpeg()&lt;/b&gt;&lt;br&gt;판정 사진 1장 (취소면 실패)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="905" width="260" height="56" as="geometry"/></mxCell><mxCell id="insp:N:h8" value="&lt;b&gt;MissionExecutor._execute()&lt;/b&gt;&lt;br&gt;판정 기록 전송, 사진이 있으면 media&lt;br&gt;전송 (판정 · 정면 · 압력계 · 신뢰도)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="990" width="270" height="80" as="geometry"/></mxCell><mxCell id="insp:N:h9" value="OCCLUDED ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="920" y="985" width="150" height="90" as="geometry"/></mxCell><mxCell id="insp:N:h9y" value="&lt;b&gt;_event()&lt;/b&gt;&lt;br&gt;정면 확보 실패 이벤트 ·&lt;br&gt;미확인 (warn)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1090" y="1002" width="160" height="56" as="geometry"/></mxCell><mxCell id="insp:N:i1" value="&lt;b&gt;MissionExecutor._execute() (⑥)&lt;/b&gt;&lt;br&gt;type이 DOCK" style="rounded=0;fillColor=#FBEFE0;strokeColor=#B98A57;dashed=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1340" y="360" width="200" height="40" as="geometry"/></mxCell><mxCell id="insp:N:i2" value="dock_status&lt;br&gt;이미 도킹?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1340" y="425" width="200" height="90" as="geometry"/></mxCell><mxCell id="insp:N:i2y" value="(True, None)" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1590" y="452" width="130" height="36" as="geometry"/></mxCell><mxCell id="insp:N:i3" value="&lt;b&gt;MissionExecutor._drive()&lt;/b&gt;&lt;br&gt;도크 접근 자세로 이동&lt;br&gt;(배터리 확인 안 함)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1340" y="560" width="240" height="56" as="geometry"/></mxCell><mxCell id="insp:N:i4" value="&lt;b&gt;RosBridge.dock()&lt;/b&gt;&lt;br&gt;도킹 액션 요청" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1340" y="650" width="240" height="56" as="geometry"/></mxCell><mxCell id="insp:N:i5" value="결과 &amp;#x27;ok&amp;#x27; ?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1340" y="740" width="200" height="90" as="geometry"/></mxCell><mxCell id="insp:N:i5n" value="(False, DOCK_FAILED · CANCELED)" style="rounded=1;arcSi