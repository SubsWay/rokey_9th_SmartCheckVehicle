bort:M21" value="C. server_page 재시작 — lifespan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontSize=12;" vertex="1" parent="1"><mxGeometry x="656" y="958" width="226" height="24" as="geometry"/></mxCell><mxCell id="abort:M22" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#111111;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="950" width="850" height="240" as="geometry"/></mxCell><mxCell id="abort:M23" value="C. client_page 재시작" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1688" y="958" width="154" height="24" as="geometry"/></mxCell><mxCell id="abort:N:a1" value="모니터 「순찰 중단」" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="180" height="40" as="geometry"/></mxCell><mxCell id="abort:N:a2" value="&lt;b&gt;abort_run()&lt;/b&gt;&lt;br&gt;POST /api/runs/{id}/abort (ADMIN_STOP)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="240" height="56" as="geometry"/></mxCell><mxCell id="abort:N:a3" value="run이 running?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="90" y="325" width="200" height="90" as="geometry"/></mxCell><mxCell id="abort:N:a3n" value="409" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="125" y="440" width="130" height="36" as="geometry"/></mxCell><mxCell id="abort:N:a4" value="&lt;b&gt;scv_abort_run()&lt;/b&gt;&lt;br&gt;남은 task 모두 취소,&lt;br&gt;run aborted (기준선 아님)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="330" y="337" width="270" height="66" as="geometry"/></mxCell><mxCell id="abort:N:a5" value="&lt;b&gt;abort_run()&lt;/b&gt;&lt;br&gt;커밋 · 진행 중 run을 비우고&lt;br&gt;배정 로봇에 run_cancel 전송" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="337" width="240" height="66" as="geometry"/></mxCell><mxCell id="abort:N:A1" value="&lt;b&gt;ScvAgent.on_message()&lt;/b&gt;&lt;br&gt;run_cancel을 on_run_cancel로 넘김" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1020" y="180" width="270" height="56" as="geometry"/></mxCell><mxCell id="abort:N:A2" value="&lt;b&gt;on_run_cancel()&lt;/b&gt;&lt;br&gt;큐 비움 · 순찰 기록 aborted ·&lt;br&gt;도크 자세 보관 · 순찰 설정 지움" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="280" height="66" as="geometry"/></mxCell><mxCell id="abort:N:A3" value="실행 중 task?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1350" y="258" width="180" height="90" as="geometry"/></mxCell><mxCell id="abort:N:A4" value="&lt;b&gt;on_run_cancel()&lt;/b&gt;&lt;br&gt;실행 중 task에 취소 신호,&lt;br&gt;결과 없이 도크 복귀 (⑥)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1580" y="270" width="250" height="66" as="geometry"/></mxCell><mxCell id="abort:N:A5" value="&lt;b&gt;on_run_cancel()&lt;/b&gt;&lt;br&gt;복귀(_RETURN)를 큐에 넣음" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1350" y="400" width="180" height="56" as="geometry"/></mxCell><mxCell id="abort:N:b1" value="&lt;b&gt;agent_resync()&lt;/b&gt;&lt;br&gt;welcome · config 뒤 재동기화 시작" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="630" y="560" width="240" height="56" as="geometry"/></mxCell><mxCell id="abort:N:b2" value="진행 중 run에&lt;br&gt;배정된 로봇?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="360" y="540" width="200" height="100" as="geometry"/></mxCell><mxCell id="abort:N:b3" value="&lt;b&gt;agent_resync()&lt;/b&gt;&lt;br&gt;run_config를 보낼 목록에 추가" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="70" y="562" width="220" height="56" as="geometry"/></mxCell><mxCell id="abort:N:b4" value="DB ACTIVE t 있음 &amp;amp;&lt;br&gt;hello.active_task_id ≠ t?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="240" height="100" as="geometry"/></mxCell><mxCell id="abort:N:b5" value="&lt;b&gt;agent_resync()&lt;/b&gt;&lt;br&gt;task_assign 다시 추가" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="70" y="785" width="220" height="44" as="geometry"/></mxCell><mxCell id="abort:N:b6" value="hello.active_task_id 있음&lt;br&gt;&amp;amp; ≠ DB ACTIVE?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="330" y="715" width="260" height="100" as="geometry"/></mxCell><mxCell id="abort:N:b7" value="&lt;b&gt;agent_resync()&lt;/b&gt;&lt;br&gt;맨 앞에 task_cancel 추가&lt;br&gt;(DB ACTIVE 없으면 도크 복귀)" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="625" y="737" width="250" height="66" as="geometry"/></mxCell><mxCell id="abort:N:b6n" value="그대로" style="rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#B98A57;strokeWidth=1.6;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="850" width="120" height="34" as="geometry"/></mxCell><mxCell id="abort:N:B1" value="&lt;b&gt;ScvAgent.run()&lt;/b&gt;&lt;br&gt;재접속 hello에 하던 task ·&lt;br&gt;보낼 기록 수를 함께 보냄" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1580" y="560" width="250" height="66" as="geometry"/></mxCell><mxCell id="abort:N:B2" value="&lt;b&gt;on_task_cancel()&lt;/b&gt;&lt;br&gt;큐에서 그 task 제거" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1020" y="640" width="260" height="56" as="geometry"/></mxCell><mxCell id="abort:N:B3" value="실행 중인&lt;br&gt;그 task?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1020" y="720" width="180" height="90" as="geometry"/></mxCell><mxCell id="abort:N:B4" value="&lt;b&gt;on_task_cancel()&lt;/b&gt;&lt;br&gt;도크 여부 저장 · 취소 신호" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1240" y="743" width="230" height="44" as="geometry"/></mxCell><mxCell id="abort:N:B5" value="go_dock &amp;amp;&lt;br&gt;task 없음?" style="rhombus;fillColor=#F6D2A2;strokeColor=#B98A57;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1020" y="830" width="180" height="76" as="geometry"/></mxCell><mxCell id="abort:N:B6" value="&lt;b&gt;on_task_cancel()&lt;/b&gt;&lt;br&gt;복귀(_RETURN)를 큐에" style="rounded=0;fillColor=#F6D2A2;strokeColor=#B98A57