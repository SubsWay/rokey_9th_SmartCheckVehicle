on.get(&amp;#x27;user_id&amp;#x27;):&lt;/b&gt;&lt;br&gt;redirect(&amp;#x27;/login&amp;#x27;)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="626" y="899" width="226" height="68" as="geometry"/></mxCell><mxCell id="c6_7" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/login  (GET → 폼)&lt;/b&gt;&lt;br&gt;POST username, password" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="3153" y="910" width="156" height="68" as="geometry"/></mxCell><mxCell id="c6_8" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;user = SELECT * FROM users WHERE username = %s&lt;/b&gt;&lt;br&gt;if user and bcrypt.checkpw(pw, user.password_hash):&lt;br&gt;    session = {user_id, role: &amp;#x27;admin&amp;#x27; | &amp;#x27;viewer&amp;#x27;}&lt;br&gt;else: /login?error=1  (실패 횟수 표시)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2532" y="948" width="334" height="100" as="geometry"/></mxCell><mxCell id="c6_9" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/logout&lt;/b&gt;&lt;br&gt;session.clear() → redirect(&amp;#x27;/login&amp;#x27;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2886" y="859" width="237" height="68" as="geometry"/></mxCell><mxCell id="c6_10" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/main  대시보드&lt;/b&gt;&lt;br&gt;로봇 카드 ×2 ← redis robot:{rid}:state&lt;br&gt;지도 요약 · 최근 이벤트 10건 ← SELECT robot_events ORDER BY ts DESC&lt;br&gt;버튼: 순찰 시작 · 비상정지 · 재개 (admin)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1255" y="124" width="406" height="100" as="geometry"/></mxCell><mxCell id="c6_11" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/map  네트워크 지도&lt;/b&gt;&lt;br&gt;처음: SELECT 마지막 run 의 칸 맵&lt;br&gt;갱신: ch:heatmap · 칸 색 = 중앙값 (−35 빨강 ~ −75 파랑, 미검출 회색)&lt;br&gt;회피 칸 테두리 · 로봇 위치 점" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1861" y="548" width="402" height="100" as="geometry"/></mxCell><mxCell id="c6_12" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/tasks  작업·로봇&lt;/b&gt;&lt;br&gt;SELECT tasks WHERE run_id = 지금 run&lt;br&gt;갱신: ch:tasks · robot:{rid}:state&lt;br&gt;열: task_id · type · robot · status · progress" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1861" y="82" width="290" height="100" as="geometry"/></mxCell><mxCell id="c6_13" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/cam  CAM&lt;/b&gt;&lt;br&gt;탭을 열 때만 IF-14 구독 시작&lt;br&gt;탭을 떠나면 구독 해제 (대역폭)&lt;br&gt;로봇 선택: robot4 | robot3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1861" y="427" width="186" height="100" as="geometry"/></mxCell><mxCell id="c6_14" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/inspections  점검 이력&lt;/b&gt;&lt;br&gt;SELECT inspections JOIN media ORDER BY inspected_at DESC&lt;br&gt;갱신: ch:inspections&lt;br&gt;셔터 SHT-01·02 는 한 줄로 묶어 표시" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1861" y="668" width="346" height="100" as="geometry"/></mxCell><mxCell id="c6_15" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/events  이벤트&lt;/b&gt;&lt;br&gt;SELECT robot_events ORDER BY ts DESC LIMIT 100&lt;br&gt;갱신: ch:events&lt;br&gt;확정 이상(findings) 「확인」 버튼 (admin)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1918" y="307" width="288" height="100" as="geometry"/></mxCell><mxCell id="c6_16" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/reports  보고서&lt;/b&gt;&lt;br&gt;SELECT reports WHERE run_id&lt;br&gt;「보고서 만들기」 → 파일 → 다운로드" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F2FB;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1949" y="202" width="226" height="84" as="geometry"/></mxCell><mxCell id="c6_17" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;/settings  설정&lt;/b&gt;&lt;br&gt;if session.role != &amp;#x27;admin&amp;#x27;: 403&lt;br&gt;SELECT settings · 폼 → UPDATE settings" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1861" y="788" width="248" height="84" as="geometry"/></mxCell><mxCell id="c6_18" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;POST /api/run/start (admin)&lt;/b&gt;&lt;br&gt;call /inspection/start (std_srvs/Trigger)&lt;br&gt;res.success → 토스트 「run_id=…」 · 실패 → res.message" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2532" y="474" width="348" height="84" as="geometry"/></mxCell><mxCell id="c6_19" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;POST /api/estop&lt;/b&gt;&lt;br&gt;call /inspection/estop (Trigger) — 역할 관계없이" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2556" y="298" width="299" height="68" as="geometry"/></mxCell><mxCell id="c6_20" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;POST /api/resume (admin)&lt;/b&gt;&lt;br&gt;call /inspection/resume (Trigger)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2599" y="578" width="214" height="68" as="geometry"/></mxCell><mxCell id="c6_21" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;POST /api/findings/{id}/ack (admin)&lt;/b&gt;&lt;br&gt;UPDATE findings SET status=&amp;#x27;acked&amp;#x27;, acked_by" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2532" y="386" width="277" height="68" as="geometry"/></mxCell><mxCell id="c6_22" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;POST /api/reports (admin)&lt;/b&gt;&lt;br&gt;칸 통계·점검표 → 파일 → INSERT reports" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2532" y="210" width="247" height="68" as="geometry"/></mxCell><mxCell id="c6_23" value="화면 구성도 — /main (모든 메뉴 화면이 같은 틀)&lt;br&gt;SCV 관제&lt;br&gt;순찰: running · run_id 1791… / ← runs.status&lt;br&gt;비상정지 / 빨강 · 항상 보임&lt;br&gt;admin · 로그아웃&lt;br&gt;메뉴 / 대시보드 / 네트워크 지도 / 작업·로봇 / CAM / 점검 이력 / 이벤트 / 보고서 / 설정 (admin)&lt;br&gt;로봇 카드 robot4 · 섹터 1 / state · battery % · task · progress / ← robot:robot4:state&lt;br&gt;로봇 카드 robot3 · 섹터 2 / (같은 구성)&lt;