ies 2&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#0B7A84;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="461" y="16" width="994" height="1241" as="geometry"/></mxCell><mxCell id="c2_3" value="&lt;b&gt;survey_buffer — 로봇 PC&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872' style='font-size:10px'&gt;시제품 manual_tagger.py (pose_source=tf) · params max_pose_age 0.5 s · max_pose_cov 0.25 m²&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#0B7A84;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="349" y="1411" width="529" height="701" as="geometry"/></mxCell><mxCell id="c2_4" value="&lt;b&gt;network_map_engine — 관제 PC&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872' style='font-size:10px'&gt;params: cell_size 0.5 · miss_ratio_thresh 0.5 · shadow_dbm −72 · rssi_weak −75(색) · rssi_strong −35 · min_samples_for_mask 2 · mask_margin 0.0&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#0B7A84;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="16" y="2266" width="1209" height="1308" as="geometry"/></mxCell><mxCell id="c2_5" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;관제 API → PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;칸 맵 저장 (5번 시트)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="993" y="3709" width="170" height="68" as="geometry"/></mxCell><mxCell id="c2_6" value="&lt;b style='font-size:12px'&gt;on_timer()  ← timer 1/rate_hz (1.0 s)&lt;/b&gt;&lt;br&gt;if fatal: return&lt;br&gt;if pending_ssid: tracker = HotspotTracker(ssid)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="62" width="294" height="69" as="geometry"/></mxCell><mxCell id="c2_7" value="&lt;b style='font-size:12px'&gt;freqs = tracker.next_freqs(monotonic())&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;list[int] MHz — 빈 리스트면 전체 대역(약 5 s)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="673" y="151" width="287" height="53" as="geometry"/></mxCell><mxCell id="c2_8" value="&lt;b style='font-size:12px'&gt;res = run_iw_scan(iface, freqs)&lt;/b&gt;&lt;br&gt;fresh = fresh_bss(res.bss, res.start_boottime, res.duration_s)&lt;br&gt;&lt;font color='#5B6872'&gt;subprocess: iw dev {iface} scan freq …&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="563" y="360" width="380" height="69" as="geometry"/></mxCell><mxCell id="c2_9" value="&lt;b style='font-size:12px'&gt;for _ in range(scan_retries=2):&lt;/b&gt;&lt;br&gt;if not res.ok or match_ssid(fresh, ssid): break&lt;br&gt;res, fresh = scan_once(freqs)   # probe 응답 누락 대비" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="589" y="521" width="329" height="69" as="geometry"/></mxCell><mxCell id="c2_10" value="&lt;b style='font-size:12px'&gt;if not res.ok:&lt;/b&gt;&lt;br&gt;if is_permission_error(res.error): fatal = True&lt;br&gt;return   # NetRaw 를 보내지 않음&lt;br&gt;&lt;font color='#5B6872'&gt;미검출로 세면 멀쩡한 칸이 회색이 되므로&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="606" y="648" width="294" height="85" as="geometry"/></mxCell><mxCell id="c2_11" value="&lt;b style='font-size:12px'&gt;tr = tracker.update(fresh, res.full, monotonic())&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;TrackResult(target: ScanBss|None, candidates, events)&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;target_ssid 비면 &amp;#x27;iPhone&amp;#x27; 든 AP 중 가장 센 것으로 고정&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="576" y="791" width="355" height="69" as="geometry"/></mxCell><mxCell id="c2_12" value="&lt;b style='font-size:12px'&gt;if tr.target is None:&lt;/b&gt;&lt;br&gt;publish(now, detected=False, rssi=None)&lt;br&gt;&lt;font color='#5B6872'&gt;misses ≥ rescan_after_miss(3) → 채널 다시 찾기&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="621" y="918" width="264" height="69" as="geometry"/></mxCell><mxCell id="c2_13" value="&lt;b style='font-size:12px'&gt;rssi = int(round(t.signal_dbm))&lt;/b&gt;&lt;br&gt;age_s = res.end_boottime - t.seen_boottime&lt;br&gt;stamp = now - age_s   # 실제로 들은 시각" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="512" y="1045" width="266" height="69" as="geometry"/></mxCell><mxCell id="c2_14" value="&lt;b style='font-size:12px'&gt;publish(stamp, detected, rssi)&lt;/b&gt;&lt;br&gt;NetRaw(stamp, robot_id, detected: bool,&lt;br&gt;       rssi_dbm: int16 = rssi if detected else 0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="593" y="1172" width="306" height="69" as="geometry"/></mxCell><mxCell id="c2_15" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;execute_precise(gh)  # IF-04 서버&lt;/b&gt;&lt;br&gt;v = [measure_scan() for duration_s] → list[int]&lt;br&gt;median = statistics.median(v)&lt;br&gt;iqr = q3 - q1 · n = len(v)&lt;br&gt;feedback elapsed_s: uint16" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="932" y="224" width="300" height="116" as="geometry"/></mxCell><mxCell id="c2_16" value="&lt;b style='font-size:12px'&gt;on_raw(raw: NetRaw)&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;tf 가 Wi-Fi 지연만큼 늦어 tf_wait 동안 기다림&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="630" y="1464" width="232" height="53" as="geometry"/></mxCell><mxCell id="c2_17" value="&lt;b style='font-size:12px'&gt;lookup_pose(raw.stamp, now)&lt;/b&gt;&lt;br&gt;tf_buffer.lookup_transform(&amp;#x27;map&amp;#x27;, &amp;#x27;base_link&amp;#x27;, t_meas)&lt;br&gt;→ (x, y, yaw, age_s, lag_s)   # 없으면 최근 TF" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="437" y="1583" width="334" height="69" as="geometry"/></mxCell><mxCell id="c2_18" value="&lt;b style='font-size:12px'&gt;pose_usable(age_s, cov_xy, 0.5, 0.25, lag_s) → (ok, why)&lt;/b&gt;&lt;br&gt;if age_s is None: (False, &amp;#x27;TF 없음&amp;#x27;)&lt;br&gt;if |lag_s| &amp;gt; 0.5 or |age_s| &amp;gt; 0.5: False&lt;br&gt;if cov_xy(=cov[0]+cov[7]) &amp;gt; 0.25: False" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="1710" width="409" height="85" as="geometry"/></mxCell><mxCell id="c2_19" value="&lt;b style='font-size:12px'&gt;publish(raw, ok)&lt;/b&gt;&lt;br&gt;seq += 1&lt;br&gt;NetSample(seq, stamp, robot_id, run_id, x, y, yaw,&lt;br&gt;          pose_ok=ok, resent=False, detected, rssi_dbm)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="435" y="1853" width="340" height="85" as="geometry"/></mxCell><mxCell id="c2_20" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;store.append(sample) · on_sync(req)&lt;/b&gt;&lt;br&gt;JSONL 한 줄 추가 (로봇 PC 디스크)&lt;br&gt;SyncSamples(run_id, from_seq) → resent=True 로 다시 발행&lt;br&gt;run_id ← RobotStatus.run_id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="374" y="1996" width="347" height="100" as="geometry"/></mxCell><mxCell id="c2_21" value="&lt;b style='font-size:12px'&gt;on_map(m: OccupancyGrid)&lt;/b&gt;&lt;br&gt;grid.set_map(origin.x, origin.y, width·res, height·res)&lt;br&gt;map_info = m.info; publish_mask()   # 빈 마스크" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="92" y="3146" width="342" height="69" as="geometry"/></mxCell><mxCell id="c2_22" value="&lt;b style='font-size:12px'&gt;on_sample(m: NetSample)&lt;/b&gt;&lt;br&gt;s = Sample(robot_id, seq, x, y, pose_ok, detected, rssi_dbm)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="547" y="2312" width="369" height="53" as="geometry"/></mxCell><mxCell id="c2_23" value="&lt;b style='font-size:12px'&gt;grid.add(s) → bool&lt;/b&gt;&lt;br&gt;if (robot_id, seq) in _seen: return False   # 중복&lt;br&gt;_seen.add(key)&lt;br&gt;if not s.pose_ok: return False   # E5&lt;br&gt;_samples.append(s); return True" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="577" y="2423" width="310" height="101" as="geometry"/></mxCell><mxCell id="c2_24" value="&lt;b style='font-size:12px'&gt;on_timer()  ← 1.0 s&lt;/b&gt;&lt;br&gt;if dirty: pub.publish(build_markers())&lt;br&gt;&lt;font color='#5B6872'&gt;칸 색 TRIANGLE_LIST + 중앙값 글자 + 샘플 점&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="611" y="2582" width="242" height="69" as="geometry"/></mxCell><mxCell id="c2_25" value="&lt;b style='font-size:12px'&gt;grid.cells() → dict[(i, j), CellStats]&lt;/b&gt;&lt;br&gt;i = floor((x - ox) / 0.5) · j = floor((y - oy) / 0.5)&lt;br&gt;detected → st.rssi.append(rssi_dbm)&lt;br&gt;else    → st.n_missed += 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="527" y="2709" width="330" height="85" as="geometry"/></mxCell><mxCell id="c2_26" value="&lt;b style='font-size:12px'&gt;CellStats&lt;/b&gt;&lt;br&gt;median = statistics.median(rssi)&lt;br&gt;miss_ratio = n_missed / n_total&lt;br&gt;n_total = len(rssi) + n_missed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="588" y="2852" width="208" height="85" as="geometry"/></mxCell><mxCell id="c2_27" value="&lt;b style='font-size:12px'&gt;cell_status(st) → &amp;#x27;miss&amp;#x27; | &amp;#x27;shadow&amp;#x27; | &amp;#x27;normal&amp;#x27;&lt;/b&gt;&lt;br&gt;if n_detected == 0 or miss_ratio &amp;gt;= 0.5: MISS&lt;br&gt;elif median &amp;lt; shadow_dbm (−72): SHADOW&lt;br&gt;else: NORMAL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="521" y="2995" width="341" height="85" as="geometry"/></mxCell><mxCell id="c2_28" value="&lt;b style='font-size:12px'&gt;on_finish()  ← ~/finish_survey (std_srvs/Trigger)&lt;/b&gt;&lt;br&gt;keepout = keepout_cells(cells, −72, 0.5, min_samples=2)&lt;br&gt;&lt;font color='#5B6872'&gt;n_total &amp;lt; 2 칸은 한 번 튄 값일 수 있어 뺌&lt;/font&gt;&lt;br&gt;survey_done = True; publish_mask()" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="454" y="3138" width="362" height="85" as="geometry"/></mxCell><mxCell id="c2_29" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;코드에 있음 · 10/12: 관제가 이 함수를 가져다 씀&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;keepout_mask(cells, 0.5, origin, res, w, h, margin)&lt;/b&gt;&lt;br&gt;→ list[int] (행 우선, 100 = KEEPOUT, 0)&lt;br&gt;OccupancyGrid(info = map_info, data)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="140" y="3289" width="368" height="84" as="geometry"/></mxCell><mxCell id="c2_30" value="&lt;b style='font-size:12px'&gt;on_reset()  ← ~/reset_survey&lt;/b&gt;&lt;br&gt;grid.clear(); keepout = {}; publish_mask()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="2312" width="266" height="53" as="geometry"/></mxCell><mxCell id="c2_31" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;unmeasured_cells(sector, margin=0.45)&lt;/b&gt;&lt;br&gt;reachable = free(map) ∩ sector ∩ dist(벽·장애물) &amp;gt; 0.45 m&lt;br&gt;unmeasured = reachable − cells().keys()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="835" y="3138" width="360" height="84" as="geometry"/></mxCell><mxCell id="c2_32" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_sector_done(sector)  # 측정 끝&lt;/b&gt;&lt;br&gt;POST /api/cells [{ix, iy, center_x, center_y, median, state}]&lt;br&gt;Candidate(source=NETWORK, kind, ref=&amp;#x27;cell-i-j&amp;#x27;, x, y=칸 중심)&lt;br&gt;&lt;font color='#5B6872'&gt;대상: MISS · SHADOW · UNMEASURED&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="828" y="3281" width="375" height="100" as="geometry"/></mxCell><mxCell id="c2_33" value="&lt;b style='font-size:12px'&gt;10/12 결정과 다른 곳&lt;/b&gt;&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ 지금 코드는 finish_survey 때 이 노드가 마스크를 직접 냄&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;결정: 마스크는 inspection_manager 가 DB 맵으로 냄&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;→ mask 발행은 관제로, keepout_cells·keepout_mask 는 공용 함수로&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5AD;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="284" y="3401" width="359" height="85" as="geometry"/></mxCell><mxCell id="c2_34" value="&lt;font color='#6B7780' style='font-size:9px'&gt;제공 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;휴대폰 핫스팟&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F2F4;strokeColor=#6B7780;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="533" y="152" width="120" height="52" as="geometry"/></mxCell><mxCell id="c2_35" value="&lt;font color='#2F5D7C' style='font-size:9px'&gt;다른 노드 (1번 시트)&lt;/fo