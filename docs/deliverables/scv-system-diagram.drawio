ner=0;" vertex="1" parent="1"><mxGeometry x="2953" y="1698" width="734" height="270" as="geometry"/></mxCell><mxCell id="c1_8" value="&lt;b&gt;go_dock(gh, waypoints) — DOCK · 배터리&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="1356" y="919" width="448" height="336" as="geometry"/></mxCell><mxCell id="c1_9" value="&lt;b style='font-size:12px'&gt;nav = TurtleBot4Navigator()&lt;/b&gt;&lt;br&gt;xyyaw = [declare_parameter(k, nan) for k in x,y,yaw]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="99" y="46" width="323" height="53" as="geometry"/></mxCell><mxCell id="c1_10" value="&lt;b style='font-size:12px'&gt;if any(isnan(v) for v in xyyaw):&lt;/b&gt;&lt;br&gt;xyyaw = HOME[ns]&lt;br&gt;&lt;font color='#5B6872'&gt;HOME[&amp;#x27;/robot4&amp;#x27;] = (2.863, 0.948, 175.8°)&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;HOME[&amp;#x27;/robot3&amp;#x27;] = (2.855, 4.656, 176.7°)  (Dock 바로 앞)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="112" y="157" width="298" height="85" as="geometry"/></mxCell><mxCell id="c1_11" value="&lt;b style='font-size:12px'&gt;if nav.getDockedStatus():  → nav.undock()&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="107" y="300" width="308" height="37" as="geometry"/></mxCell><mxCell id="c1_12" value="&lt;b style='font-size:12px'&gt;nav.setInitialPose(home)&lt;/b&gt;&lt;br&gt;nav.waitUntilNav2Active()&lt;br&gt;&lt;font color='#5B6872'&gt;Dock 에서는 lidar 가 꺼져 있어 HOME 을 초기 위치로&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="126" y="357" width="269" height="69" as="geometry"/></mxCell><mxCell id="c1_13" value="&lt;b style='font-size:12px'&gt;node = MissionExecutor(nav, home)&lt;/b&gt;&lt;br&gt;MultiThreadedExecutor.spin (스레드)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="339" y="492" width="247" height="53" as="geometry"/></mxCell><mxCell id="c1_14" value="&lt;b style='font-size:12px'&gt;while ok: (0.5 s)&lt;/b&gt;&lt;br&gt;if not busy and battery &amp;lt;= 15.0&lt;br&gt;   and state != STATE_DOCKED:&lt;br&gt;     go_dock(None, [])   # E2&lt;br&gt;&lt;font color='#5B6872'&gt;self.battery ← on_battery()&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="361" y="610" width="202" height="101" as="geometry"/></mxCell><mxCell id="c1_15" value="&lt;b style='font-size:12px'&gt;on_battery(msg: BatteryState)&lt;/b&gt;&lt;br&gt;self.battery = msg.percentage * 100.0  # float 0–100" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="966" y="216" width="323" height="53" as="geometry"/></mxCell><mxCell id="c1_16" value="&lt;b style='font-size:12px'&gt;on_pose(msg: PoseWithCovarianceStamped)&lt;/b&gt;&lt;br&gt;yaw = atan2(2(wz+xy), 1-2(y²+z²))&lt;br&gt;std = sqrt(max(cov[0], cov[7], 0))&lt;br&gt;self.pose = (x, y, yaw, std)  # tuple[float×4]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="652" y="200" width="294" height="85" as="geometry"/></mxCell><mxCell id="c1_17" value="&lt;b style='font-size:12px'&gt;publish_status()  ← timer 1.0 s&lt;/b&gt;&lt;br&gt;accepting_tasks = battery &amp;gt; 30.0&lt;br&gt;pose_ok = pose[3] &amp;lt;= pose_std_max (0.15 m)&lt;br&gt;task_id, run_id, task_type ← self.task&lt;br&gt;state ∈ IDLE·EXECUTING·BLOCKED·DOCKING·DOCKED" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="702" y="343" width="291" height="101" as="geometry"/></mxCell><mxCell id="c1_18" value="&lt;b style='font-size:12px'&gt;on_goal(goal) → GoalResponse&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;self.battery ← on_battery()&lt;/font&gt;&lt;br&gt;if busy or (battery &amp;lt;= 30.0&lt;br&gt;           and goal.type != DOCK):&lt;br&gt;    return REJECT&lt;br&gt;busy = True; return ACCEPT" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3327" y="184" width="220" height="117" as="geometry"/></mxCell><mxCell id="c1_19" value="&lt;b style='font-size:12px'&gt;execute(gh): g = gh.request&lt;/b&gt;&lt;br&gt;if state == STATE_DOCKED and g.type != DOCK:&lt;br&gt;    nav.undock(); nav.setInitialPose(home)&lt;br&gt;state = STATE_EXECUTING" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3298" y="359" width="277" height="85" as="geometry"/></mxCell><mxCell id="c1_20" value="&lt;b style='font-size:12px'&gt;match g.type:&lt;/b&gt;&lt;br&gt;SURVEY_SEGMENT=0 · FACILITY_CHECK=1&lt;br&gt;REINSPECTION=2 · DOCK=3 · 그 외 → &amp;#x27;UNKNOWN_TYPE&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3284" y="502" width="305" height="69" as="geometry"/></mxCell><mxCell id="c1_21" value="&lt;b style='font-size:12px'&gt;if not waypoints:&lt;/b&gt;&lt;br&gt;    return (False, &amp;#x27;NO_WAYPOINTS&amp;#x27;)&lt;br&gt;if precise: set_tolerance(0.05, 0.087)&lt;br&gt;finally: set_tolerance(0.10, 0.17)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3366" y="831" width="242" height="85" as="geometry"/></mxCell><mxCell id="c1_22" value="&lt;b style='font-size:12px'&gt;nav.goThroughPoses(waypoints)&lt;/b&gt;&lt;br&gt;last_xy, last_t = None, time()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3140" y="996" width="220" height="53" as="geometry"/></mxCell><mxCell id="c1_23" value="&lt;b style='font-size:12px'&gt;while not nav.isTaskComplete():  (0.2 s)&lt;/b&gt;&lt;br&gt;if gh.is_cancel_requested or battery &amp;lt;= 15.0:&lt;br&gt;    nav.cancelTask(); stop()&lt;br&gt;    return (False, &amp;#x27;CANCELED&amp;#x27; | &amp;#x27;LOW_BATTERY&amp;#x27;)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2745" y="1076" width="294" height="85" as="geometry"/></mxCell><mxCell id="c1_24" value="&lt;b style='font-size:12px'&gt;fb = nav.getFeedback()&lt;/b&gt;&lt;br&gt;i = done + len(wp) - fb.number_of_poses_remaining&lt;br&gt;progress = i / n&lt;br&gt;gh.publish_feedback(ExecuteTask.Feedback(i, progress))" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2455" y="1273" width="334" height="85" as="geometry"/></mxCell><mxCell id="c1_25" value="&lt;b style='font-size:12px'&gt;xy = self.pose[:2]   # E1 막힘&lt;/b&gt;&lt;br&gt;if dist(xy, last_xy) &amp;gt; 0.05: last_t = now&lt;br&gt;elif now - last_t &amp;gt; 10.0: break  → 건너뜀&lt;br&gt;elif now - last_t &amp;gt; 5.0: state = BLOCKED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2921" y="678" width="263" height="85" as="geometry"/></mxCell><mxCell id="c1_26" value="&lt;b style='font-size:12px'&gt;nav.cancelTask()   # 건너뜀&lt;/b&gt;&lt;br&gt;k = len(wp) - fb.number_of_poses_remaining&lt;br&gt;waypoints = waypoints[k+1:]; skipped += 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2986" y="839" width="266" height="69" as="geometry"/></mxCell><mxCell id="c1_27" value="&lt;b style='font-size:12px'&gt;res = nav.getResult()&lt;/b&gt;&lt;br&gt;if res == TaskResult.SUCCEEDED:&lt;br&gt;    (True, &amp;#x27;&amp;#x27;) if skipped == 0&lt;br&gt;    else (False, f&amp;#x27;BLOCKED skipped={n}&amp;#x27;)&lt;br&gt;else (False, str(res))" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2993" y="1269" width="254" height="101" as="geometry"/></mxCell><mxCell id="c1_28" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;kind = KIND.get(g.target_ref[:3], 0)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27;&gt;EXT→1 · SHT→2 · EXL→3 · RCK→4&lt;/font&gt;&lt;br&gt;req = InspectFacility.Request(task_id, run_id, facility_id=target_ref, kind)&lt;br&gt;&lt;font color=&#x27;#A33A2B&#x27;&gt;&lt;b&gt;⚠ 10/14 IF-05 action → service · 코드는 T2-6 에서&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2236" y="1634" width="404" height="101" as="geometry"/></mxCell><mxCell id="c1_29" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;inspect_cli.call_async(req)  # IF-05 서비스 (10/14)&lt;/b&gt;&lt;br&gt;if not wait_for_service(5.0): (None,&amp;#x27;NO_SERVER&amp;#x27;)&lt;br&gt;while not future.done(): 0.1 s&lt;br&gt;if gh.is_cancel_requested: 응답 기다리지 않음 → &amp;#x27;CANCELED&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2267" y="1821" width="341" height="85" as="geometry"/></mxCell><mxCell id="c1_30" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;&lt;font color=&#x27;#A33A2B&#x27;&gt;&lt;b&gt;삭제 (10/14) — 자세 보정 주행 없음 · T2-6 에서 코드 삭제&lt;/b&gt;&lt;/font&gt;&lt;br&gt;do_adjust(adjust)&lt;/b&gt;&lt;br&gt;if f.adjust_yaw: nav.spin(f.adjust_yaw)&lt;br&gt;if f.adjust_forward_m &amp;gt; 0: nav.driveOnHeading(f.adjust_forward_m)&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27;&gt;후진은 하지 않음 (뒤에 센서 없음)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1849" y="1821" width="398" height="85" as="geometry"/></mxCell><mxCell id="c1_31" value="&lt;b style='font-size:12px'&gt;ok = res.verdict != UNCONFIRMED&lt;/b&gt;&lt;br&gt;reason = f&amp;#x27;verdict={res.verdict} {res.detail}&amp;#x27;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2628" y="1837" width="288" height="53" as="geometry"/></mxCell><mxCell id="c1_32" value="&lt;b style='font-size:12px'&gt;goal = PreciseMeasure.Goal(duration_s=30)&lt;/b&gt;&lt;br&gt;call_action(precise_cli, goal, gh)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3033" y="1728" width="301" height="53" as="geometry"/></mxCell><mxCell id="c1_33" value="&lt;b style='font-size:12px'&gt;return (True, f&amp;#x27;median={m:.1f} iqr={q:.1f} n={n}&amp;#x27;)&lt;/b&gt;&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ 지금 코드는 측정값을 reason 문자열로만 보냄&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;10/12 결정 (interfaces v0.2.10): Result.rssi_median · rssi_iqr ·&lt;/font&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;  n_samples 에 PreciseMeasure 결과를 그대로 넣는다&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpa