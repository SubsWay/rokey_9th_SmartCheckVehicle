Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_24" target="c2_39"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="2651" as="sourcePoint"/><mxPoint x="945" y="2709" as="targetPoint"/><Array as="points"><mxPoint x="772" y="2661"/><mxPoint x="945" y="2661"/></Array></mxGeometry></mxCell><mxCell id="c2_66" value="build_markers() 안에서" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_24" target="c2_25"><mxGeometry relative="1" as="geometry"><mxPoint x="692" y="2651" as="sourcePoint"/><mxPoint x="692" y="2709" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_67" value="st: CellStats" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_25" target="c2_26"><mxGeometry relative="1" as="geometry"><mxPoint x="692" y="2794" as="sourcePoint"/><mxPoint x="692" y="2852" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_68" value="median: float | None · miss_ratio: float" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_26" target="c2_27"><mxGeometry relative="1" as="geometry"><mxPoint x="692" y="2937" as="sourcePoint"/><mxPoint x="692" y="2995" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_69" value="status: str" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_27" target="c2_28"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="3080" as="sourcePoint"/><mxPoint x="635" y="3138" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_70" value="keepout: dict[(i,j), &amp;#x27;miss&amp;#x27;|&amp;#x27;shadow&amp;#x27;]" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_28" target="c2_29"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="3223" as="sourcePoint"/><mxPoint x="386" y="3289" as="targetPoint"/><Array as="points"><mxPoint x="635" y="3271"/><mxPoint x="386" y="3271"/></Array></mxGeometry></mxCell><mxCell id="c2_71" value="map_info: MapMetaData" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c2_21" target="c2_29"><mxGeometry relative="1" as="geometry"><mxPoint x="263" y="3215" as="sourcePoint"/><mxPoint x="263" y="3289" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_72" value="mask_topic (/keepout_mask) · OccupancyGrid&lt;br&gt;→ 10/12: 관제가 {ns}/keepout_mask 로" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_29" target="c2_40"><mxGeometry relative="1" as="geometry"><mxPoint x="263" y="3373" as="sourcePoint"/><mxPoint x="263" y="3506" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_73" value="cells: dict" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_27" target="c2_31"><mxGeometry relative="1" as="geometry"><mxPoint x="748" y="3080" as="sourcePoint"/><mxPoint x="1016" y="3138" as="targetPoint"/><Array as="points"><mxPoint x="748" y="3090"/><mxPoint x="1016" y="3090"/></Array></mxGeometry></mxCell><mxCell id="c2_74" value="unmeasured: set[(i,j)]" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_31" target="c2_32"><mxGeometry relative="1" as="geometry"><mxPoint x="1016" y="3222" as="sourcePoint"/><mxPoint x="1016" y="3281" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_75" value="HTTP POST JSON · 칸 맵" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2B6A55;strokeWidth=1.5;fontSize=9;fontFamily=Courier New;fontColor=#235645;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_32" target="c2_5"><mxGeometry relative="1" as="geometry"><mxPoint x="1078" y="3381" as="sourcePoint"/><mxPoint x="1078" y="3709" as="targetPoint"/><Array as="points"><mxPoint x="1078" y="3579"/></Array></mxGeometry></mxCell><mxCell id="c2_76" value="IF-15 /inspection/candidates · scv_msgs/Candidate" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_32" target="c2_41"><mxGeometry relative="1" as="geometry"><mxPoint x="953" y="3381" as="sourcePoint"/><mxPoint x="953" y="3506" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c2_77" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2_29" target="c2_33"><mxGeometry relative="1" as="geometry"><mxPoint x="386" y="3373" as="sourcePoint"/><mxPoint x="463" y="3401" as="targetPoint"/><Array as="points"><mxPoint x="386" y="3391"/><mxPoint x="463" y="3391"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s3" name="3 Detection · detection_alert"><mxGraphModel dx="1609" dy="2252" grid="0" page="0" pageWidth="1609" pageHeight="2252"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3_2" value="&lt;b&gt;detection_alert — 로봇 PC (MSI GPU)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27; style=&#x27;font-size:10px&#x27;&gt;IF-05 {ns}/inspect_facility 서비스 서버 (10/14) · 영상은 계속 구독, 요청 때 판정 · 자세 보정 없음&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#8E5600;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="16" y="16" width="1577" height="2220" as="geometry"/></mxCell><mxCell id="c3_3" value="&lt;font color=&#x27;#8E5600&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;on_request(req, res)&lt;/b&gt;&lt;br&gt;fac = facilities[req.facility_id]&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27;&gt;expected(x, y) · band 꼭짓점 · view&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="679" y="202" width="206" height="100" as="geometry"/></mxCell><mxCell id="c3_4" value="&lt;font color=&#x27;#8E5600&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;subscribe RGB + depth (처음부터 계속, 10/14)&lt;/b&gt;&lt;br&gt;요청이 오면 최근 3장 (timeout)&lt;br&gt;rgb: CompressedImage · depth: Image 16UC1 [mm]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="453" y="374" width="289" height="84" as="geometry"/></mxCell><mxCell id="c3_5" value="&lt;b style='font-size:12px'&gt;frame = cv2.imdecode(np.frombuffer(msg.data, uint8), IMREAD_COLOR)&lt;/b&gt;&lt;br&gt;if frame is None: 다음 프레임&lt;br&gt;&lt;font color='#5B6872'&gt;ndarray (H, W, 3) uint8 — test.py 와 같음&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="315" y="516" width="470" height="69" as="geometry"/></mxCell><mxCell id="c3_6" value="&lt;font color=&#x27;#9A6B00&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;match g.kind:&lt;/b&gt;&lt;br&gt;1 EXTINGUISHER · 3 EXIT_LIGHT · 4 RACK → YOLO (yolo26n, 10/14)&lt;br&gt;2 SHUTTER → depth (학습 없음)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="431" y="643" width="238" height="100" as="geometry"/></mxCell><mxCell id="c3_7" value="&lt;b style='font-size:12px'&gt;r = model.predict(frame, conf=0.25, iou=0.45, imgsz=640)[0]&lt;/b&gt;&lt;br&gt;boxes: cls: int · conf: float · xyxy: float[4]&lt;br&gt;&lt;font color='#5B6872'&gt;3장 중 대상 클래스가 잡힌 장 수로 판단&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="599" y="801" width="422" height="69" as="geometry"/></mxCell><mxCell id="c3_8" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;if hits == 0:   # hits = 3장 중 대상 cls 가 잡힌 장 수&lt;/b&gt;&lt;br&gt;roi = depth[project(fac.expected)]   # uint16 [mm]&lt;br&gt;if np.median(roi) / 1000 &amp;lt; d_exp - 0.2:   # d_exp = |view − expected|&lt;br&gt;    verdict = OCCLUDED&lt;br&gt;else: verdict = NOT_DETECTED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="599" y="1010" width="421" height="116" as="geometry"/></mxCell><mxCell id="c3_9" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;u, v = box.center; z = depth[v, u] / 1000.0&lt;/b&gt;&lt;br&gt;p_cam = pinhole(u, v, z, K)   # K ← camera_info&lt;br&gt;x, y = tf_buffer.transform(p_cam, &amp;#x27;map&amp;#x27;)&lt;br&gt;if hypot(x - ex, y - ey) &amp;gt; pos_tol:   # 0.5 m 제안&lt;br&gt;    verdict = POSITION_ANOMALY" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="751" y="1184" width="314" height="116" as="geometry"/></mxCell><mxCell id="c3_10" value="&lt;font color=&#x27;#9A6B00&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;front = is_frontal(box, frame.shape)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27;&gt;w/h ≥ 0.6 and |cx − W/2| ≤ 0.15·W  (제안값)&lt;/font&gt;&lt;br&gt;if not front:&lt;br&gt;    verdict = UNCONFIRMED   # E6 · 자세 보정 주행 없음 (10/14)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="989" y="1358" width="363" height="132" as="geometry"/></mxCell><mxCell id="c3_11" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;verdict = judge(kind, crop)&lt;/b&gt;&lt;br&gt;EXTINGUISHER: g = hsv_ratio(gauge, H 35–85)&lt;br&gt;    NORMAL if g ≥ g_min else ABNORMAL&lt;br&gt;EXIT_LIGHT: v = mean(hsv[..., 2] in box)&lt;br&gt;    NORMAL if v ≥ v_min else ABNORMAL&lt;br&gt;&lt;font color='#5B6872'&gt;g_min · v_min 은 비전 팀이 시험으로 정함&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1282" y="1576" width="272" height="132" as="geometry"/></mxCell><mxCell id="c3_12" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;h = height_map(depth, band_roi)   # SHUTTER&lt;/b&gt;&lt;br&gt;band_roi ← fac.band 4꼭짓점 → 영상 다각형&lt;br&gt;h = 바닥 평면 대비 높이 [m] (depth → 3D)&lt;br&gt;verdict = ABNORMAL if h.max() ≥ 0.10 else NORMAL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="392" y="890" width="314" height="100" as="geometry"/></mxCell><mxCell id="c3_13" value="&lt;font color=&#x27;#9A6B00&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#A33A2B&#x27;&gt;&lt;b&gt;10/14 부터 랙도 yolo26n 으로 판정 — 아래 OpenCV 는 옛 설계&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;edges = cv2.Canny(gray, 50, 150)   # RACK&lt;/b&gt;&lt;br&gt;lines = cv2.HoughLinesP(edges, …) → 랙 경계선 x_edge&lt;br&gt;cnts = cv2.findContours(box_mask, …)&lt;br&gt;verdict = ABNORMAL if any(c.x_max &amp;gt; x_edge) else NORMAL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="32" y="890" width="340" height="100" as="geometry"/></mxCell><mxCell id="c3_14" value="&lt;font color='#8E5600' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;save_evidence(frame, box)&lt;/b&gt;&lt;br&gt;image_ref = cv2.imwrite(원본 경로)&lt;br&gt;thumb = resize(긴 변 ≤ 640) → imencode(&amp;#x27;.jpg&amp;#x27;)&lt;br&gt;image = CompressedImage(format=&amp;#x27;jpeg&amp;#x27;, data)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="160" y="1806" width="298" height="100" as="geometry"/></mxCell><mxCell id="c3_15" value="&lt;font color=&#x27;#8E5600&#x27; style=&#x27;font-size:9px&#x27;&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;finish(res, verdict, detail)&lt;/b&gt;&lt;br&gt;return InspectFacility.Response(verdict, detail, image_ref)&lt;br&gt;pub.publish(InspectionResult(robot_id, run_id, task_id, facility_id,&lt;br&gt;            kind, verdict, detail, image_ref, image, attempts))&lt;br&gt;&lt;font color=&#x27;#5B6872&#x27;&gt;run_id ← req.run_id · attempts = 1 (interfaces v0.2.10, 10/12)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="1964" width="432" height="116" as="geometry"/></mxCell><mxCell id="c3_16" value="&lt;font color='#2F5D7C' style='font-size:9px'&gt;다른 노드 (1번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;mission_executor&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="919" y="78" width="132" height="52" as="geometry"/></mxCell><mxCell id="c3_17" value="&lt;font color='#8A6D1F' style='font-size:9px'&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;facilities.yaml&lt;/b&gt;&lt;br&gt;id · kind · expected{x,y} · view{x,y,yaw} · band" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="596" y="62" width="303" height="68" as="geometry"/></mxCell><mxCell id="c3_18" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;제공 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;oakd (depthai-ros)&lt;/b&gt;&lt;br&gt;{ns}/oakd/rgb/image_raw/compressed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEECF6;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="234" width="220" height="68" as="geometry"/></mxCell><mxCell id="c3_19" value="&lt;font color=&#x27;#8A6D1F&#x27; style=&#x27;font-size:9px&#x27;&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;best.pt (yolo26n, 10/14)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="814" y="691" width="132" height="52" as="geometry"/></mxCell><mxCell id="c3_20" value="&lt;font color='#5B4BA6' style='font-size:9px'&gt;제공 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;tf2 (camera → map)&lt;/b&gt;&lt;br&gt;oakd_rgb_camera_optical_frame → map" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEECF6;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1041" y="1058" width="231" height="68" as="geometry"/></mxCell><mxCell id="c3_21" value="&lt;font color=&#x27;#2F5D7C&#x27; style=&#x27;font-size:9px&#x27;&gt;다른 노드 (1번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;mission_executor&lt;/b&gt;&lt;br&gt;inspect() 반환" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1078" y="1576" width="184" height="68" as="geometry"/></mxCell><mxCell id="c3_22" value="&lt;font color='#8A6D1F' style='font-size:9px'&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;로봇 PC 디스크&lt;/b&gt;&lt;br&gt;~/scv_media/{run_id}/{task_id}_{facility_id}_{n}.jpg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="97" y="1964" width="323" height="68" as="geometry"/></mxCell><mxCell id="c3_23" value="&lt;font color=&#x27;#2F5D7C&#x27; style=&#x27;font-size:9px&#x27;&gt;다른 노드 (1번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style=&#x27;font-size:12px&#x27;&gt;mission_executor&lt;/b&gt;&lt;br&gt;inspect() 반환" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="796" y="2152" width="184" height="68" as="geometry"/></mxCell><mxCell id="c3_24" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;다른 노드 (4번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;inspection_manager&lt;/b&gt;&lt;br&gt;on_inspection_result()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="581" y="2152" width="150" height="68" as="geometry"/></mxCell><mxCell id="c3_25" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;다른 노드 (5번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;ros_bridge → inspections · media&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="2152" width="248" height="52" as="geometry"/></mxCell><mxCell id="c3_27" value="IF-05 InspectFacility.Request (service)&lt;br&gt;(task_id: str, run_id: uint32, facility_id: str, kind: uint8)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#5B4BA6;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#4A3D88;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_16" target="c3_3"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="130" as="sourcePoint"/><mxPoint x="817" y="202" as="targetPoint"/><Array as="points"><mxPoint x="985" y="192"/><mxPoint x="817" y="192"/></Array></mxGeometry></mxCell><mxCell id="c3_28" value="dict (yaml.safe_load)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_17" target="c3_3"><mxGeometry relative="1" as="geometry"><mxPoint x="748" y="130" as="sourcePoint"/><mxPoint x="748" y="202" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_29" value="fac: dict" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_3" target="c3_4"><mxGeometry relative="1" as="geometry"><mxPoint x="782" y="302" as="sourcePoint"/><mxPoint x="646" y="374" as="targetPoint"/><Array as="points"><mxPoint x="782" y="364"/><mxPoint x="646" y="364"/></Array></mxGeometry></mxCell><mxCell id="c3_30" value="IF-14 CompressedImage (BEST_EFFORT, depth 1)&lt;br&gt;+ sensor_msgs/Image 16UC1" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_18" target="c3_4"><mxGeometry relative="1" as="geometry"><mxPoint x="549" y="302" as="sourcePoint"/><mxPoint x="549" y="374" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_31" value="msg: CompressedImage" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_4" target="c3_5"><mxGeometry relative="1" as="geometry"><mxPoint x="549" y="458" as="sourcePoint"/><mxPoint x="549" y="516" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_32" value="frame: ndarray" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_5" target="c3_6"><mxGeometry relative="1" as="geometry"><mxPoint x="549" y="585" as="sourcePoint"/><mxPoint x="549" y="643" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_33" value="YOLO(weights)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_19" target="c3_7"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="743" as="sourcePoint"/><mxPoint x="880" y="801" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_34" value="1 · 3" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2B6A55;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#235645;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_6" target="c3_7"><mxGeometry relative="1" as="geometry"><mxPoint x="609" y="743" as="sourcePoint"/><mxPoint x="740" y="801" as="targetPoint"/><Array as="points"><mxPoint x="609" y="753"/><mxPoint x="740" y="753"/></Array></mxGeometry></mxCell><mxCell id="c3_35" value="2" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_6" target="c3_12"><mxGeometry relative="1" as="geometry"><mxPoint x="549" y="743" as="sourcePoint"/><mxPoint x="549" y="890" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_36" value="4" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_6" target="c3_13"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="743" as="sourcePoint"/><mxPoint x="202" y="890" as="targetPoint"/><Array as="points"><mxPoint x="490" y="753"/><mxPoint x="202" y="753"/></Array></mxGeometry></mxCell><mxCell id="c3_37" value="r.boxes: Boxes" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c3_7" target="c3_8"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="870" as="sourcePoint"/><mxPoint x="810" y="1010" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_38" value="대상 있음 · box" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2B6A55;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#235645;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_8" target="c3_9"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="1126" as="sourcePoint"/><mxPoint x="855" y="1184" as="targetPoint"/><Array as="points"><mxPoint x="880" y="1136"/><mxPoint x="855" y="1136"/></Array></mxGeometry></mxCell><mxCell id="c3_39" value="NOT_DETECTED | OCCLUDED" style="edgeStyle=none;html=1;rounded=1;strokeColor=#A33A2B;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#852F23;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_8" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1126" as="sourcePoint"/><mxPoint x="287" y="1806" as="targetPoint"/><Array as="points"><mxPoint x="740" y="1766"/><mxPoint x="287" y="1766"/></Array></mxGeometry></mxCell><mxCell id="c3_40" value="TransformStamped" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_20" target="c3_9"><mxGeometry relative="1" as="geometry"><mxPoint x="1156" y="1126" as="sourcePoint"/><mxPoint x="960" y="1184" as="targetPoint"/><Array as="points"><mxPoint x="1156" y="1174"/><mxPoint x="960" y="1174"/></Array></mxGeometry></mxCell><mxCell id="c3_41" value="위치 일치" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2B6A55;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#235645;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_9" target="c3_10"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="1300" as="sourcePoint"/><mxPoint x="1110" y="1358" as="targetPoint"/><Array as="points"><mxPoint x="960" y="1310"/><mxPoint x="1110" y="1310"/></Array></mxGeometry></mxCell><mxCell id="c3_42" value="POSITION_ANOMALY" style="edgeStyle=none;html=1;rounded=1;strokeColor=#A33A2B;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#852F23;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_9" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="1300" as="sourcePoint"/><mxPoint x="330" y="1806" as="targetPoint"/><Array as="points"><mxPoint x="855" y="1776"/><mxPoint x="330" y="1776"/></Array></mxGeometry></mxCell><mxCell id="c3_45" value="정면" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2B6A55;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#235645;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_10" target="c3_11"><mxGeometry relative="1" as="geometry"><mxPoint x="1261" y="1490" as="sourcePoint"/><mxPoint x="1418" y="1576" as="targetPoint"/><Array as="points"><mxPoint x="1261" y="1500"/><mxPoint x="1418" y="1500"/></Array></mxGeometry></mxCell><mxCell id="c3_46" value="UNCONFIRMED" style="edgeStyle=none;html=1;rounded=1;strokeColor=#A33A2B;strokeWidth=1.4;fontSize=9;fontFamily=Courier New;fontColor=#852F23;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_10" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="1490" as="sourcePoint"/><mxPoint x="372" y="1806" as="targetPoint"/><Array as="points"><mxPoint x="1080" y="1500"/><mxPoint x="934" y="1500"/><mxPoint x="934" y="1786"/><mxPoint x="372" y="1786"/></Array></mxGeometry></mxCell><mxCell id="c3_47" value="verdict: uint8 · detail: str" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_11" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="1418" y="1708" as="sourcePoint"/><mxPoint x="415" y="1806" as="targetPoint"/><Array as="points"><mxPoint x="1418" y="1796"/><mxPoint x="415" y="1796"/></Array></mxGeometry></mxCell><mxCell id="c3_48" value="verdict · detail" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_12" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="549" y="990" as="sourcePoint"/><mxPoint x="245" y="1806" as="targetPoint"/><Array as="points"><mxPoint x="549" y="1756"/><mxPoint x="245" y="1756"/></Array></mxGeometry></mxCell><mxCell id="c3_49" value="verdict · detail" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_13" target="c3_14"><mxGeometry relative="1" as="geometry"><mxPoint x="202" y="990" as="sourcePoint"/><mxPoint x="202" y="1806" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_50" value="cv2.imwrite(JPEG)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_14" target="c3_22"><mxGeometry relative="1" as="geometry"><mxPoint x="259" y="1906" as="sourcePoint"/><mxPoint x="259" y="1964" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_51" value="image_ref: str · image: CompressedImage" style="edgeStyle=none;html=1;rounded=1;strokeColor=#33414B;strokeWidth=1.3;fontSize=9;fontFamily=Courier New;fontColor=#29353D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_14" target="c3_15"><mxGeometry relative="1" as="geometry"><mxPoint x="358" y="1906" as="sourcePoint"/><mxPoint x="656" y="1964" as="targetPoint"/><Array as="points"><mxPoint x="358" y="1916"/><mxPoint x="656" y="1916"/></Array></mxGeometry></mxCell><mxCell id="c3_52" value="IF-05 Response(verdict, detail, image_ref)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#5B4BA6;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#4A3D88;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_15" target="c3_23"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="2080" as="sourcePoint"/><mxPoint x="888" y="2152" as="targetPoint"/><Array as="points"><mxPoint x="765" y="2090"/><mxPoint x="888" y="2090"/></Array></mxGeometry></mxCell><mxCell id="c3_53" value="IF-19 {ns}/inspect/result · InspectionResult&lt;br&gt;RELIABLE · TRANSIENT_LOCAL · depth 50" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_15" target="c3_24"><mxGeometry relative="1" as="geometry"><mxPoint x="656" y="2080" as="sourcePoint"/><mxPoint x="656" y="2152" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c3_54" value="IF-19 InspectionResult" style="edgeStyle=none;html=1;rounded=1;strokeColor=#0B7A84;strokeWidth=1.7;fontSize=9;fontFamily=Courier New;fontColor=#09646C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c3_15" target="c3_25"><mxGeometry relative="1" as="geometry"><mxPoint x="548" y="2080" as="sourcePoint"/><mxPoint x="404" y="2152" as="targetPoint"/><Array as="points"><mxPoint x="548" y="2090"/><mxPoint x="404" y="2090"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s4" name="4 관제 · inspection_manager"><mxGraphModel dx="3987" dy="2141" grid="0" page="0" pageWidth="3987" pageHeight="2141"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4_2" value="&lt;b&gt;inspection_manager — 관제 PC&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872' style='font-size:10px'&gt;params: robot_ids [robot4, robot3] · survey_robot_id robot4 · inspection_robot_id robot3 · offline_timeout_sec 29.0 · require_robot_ready True&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="16" y="16" width="3955" height="2109" as="geometry"/></mxCell><mxCell id="c4_3" value="&lt;b&gt;로봇 상태 · 감시&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="32" y="371" width="616" height="288" as="geometry"/></mxCell><mxCell id="c4_4" value="&lt;b&gt;순찰 시작 — /inspection/start (std_srvs/Trigger)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="668" y="62" width="699" height="901" as="geometry"/></mxCell><mxCell id="c4_5" value="&lt;b&gt;작업 보내기 — IF-11 ExecuteTask 클라이언트&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="889" y="1031" width="1680" height="1078" as="geometry"/></mxCell><mxCell id="c4_6" value="&lt;b&gt;후보 → 재측정 작업 (추가분)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="1387" y="533" width="810" height="430" as="geometry"/></mxCell><mxCell id="c4_7" value="&lt;b&gt;비상정지 · 재개 · 재배정&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="2929" y="340" width="1026" height="351" as="geometry"/></mxCell><mxCell id="c4_8" value="&lt;b style='font-size:12px'&gt;on_robot_status(robot_id, msg: RobotStatus)&lt;/b&gt;&lt;br&gt;snap = RobotStatusSnapshot(state, battery_percent,&lt;br&gt;   accepting_tasks, task_id, run_id, task_type, progress, warning)&lt;br&gt;core.update_robot(robot_id, monotonic(), snap)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="229" y="558" width="404" height="85" as="geometry"/></mxCell><mxCell id="c4_9" value="&lt;b style='font-size:12px'&gt;check_robot_timeouts()  ← timer 1.0 s&lt;/b&gt;&lt;br&gt;for rid in core.check_offline(now):&lt;br&gt;  # now - last_seen &amp;gt;= 29.0 → online = False&lt;br&gt;  publish_alert(ERROR, &amp;#x27;E3&amp;#x27;, rid)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="401" width="283" height="85" as="geometry"/></mxCell><mxCell id="c4_10" value="&lt;b style='font-size:12px'&gt;on_start(req, res)&lt;/b&gt;&lt;br&gt;if run_state in {RUNNING, ESTOPPED}:&lt;br&gt;    res.success = False   # 이미 진행 중" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1018" y="202" width="249" height="69" as="geometry"/></mxCell><mxCell id="c4_11" value="&lt;b style='font-size:12px'&gt;route_builder.build_survey_routes()&lt;/b&gt;&lt;br&gt;for zone in zones: _build_scanline_route(polygon, spacing)&lt;br&gt;  y = min_y + spacing/2, … &amp;lt; max_y (spacing 씩)&lt;br&gt;  가장자리 교차 x 두 개 → Waypoint(x, y, yaw 0 | π) 번갈아&lt;br&gt;→ list[SurveyRoute(zone_id, waypoints)]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="722" y="329" width="358" height="101" as="geometry"/></mxCell><mxCell id="c4_12" value="&lt;b style='font-size:12px'&gt;route_builder.build_facility_routes()&lt;/b&gt;&lt;br&gt;→ list[FacilityRoute(facility_id, (Waypoint(view.x, view.y, view.yaw),))]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="751" y="488" width="450" height="53" as="geometry"/></mxCell><mxCell id="c4_13" value="&lt;b style='font-size:12px'&gt;run_id = core.start_run(int(time.time()))&lt;/b&gt;&lt;br&gt;run_state = RUNNING; tasks.clear()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="825" y="599" width="301" height="53" as="geometry"/></mxCell><mxCell id="c4_14" value="&lt;b style='font-size:12px'&gt;core.create_task(…) — 계획분&lt;/b&gt;&lt;br&gt;task_id = f&amp;#x27;run-{run_id}-survey-{n:03d}&amp;#x27; · SURVEY_SEGMENT&lt;br&gt;task_id = f&amp;#x27;run-{run_id}-facility-{n:03d}&amp;#x27; · FACILITY_CHECK&lt;br&gt;priority = 1 · preferred_robot_id = survey | inspection&lt;br&gt;→ TaskRecord(state=PENDING) · task_order.append" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="794" y="710" width="364" height="101" as="geometry"/></mxCell><mxCell id="c4_15" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;10/12: 섹터·로봇별 작업 목록&lt;/b&gt;&lt;br&gt;robot = zone[&amp;#x27;robot&amp;#x27;]  # zones.yaml robot:&lt;br&gt;로봇마다: SURVEY → DOCK → (REINSPECTION…) → DOCK&lt;br&gt;           → FACILITY(그 섹터 설비) … → DOCK&lt;br&gt;survey_robot_id · inspection_robot_id 파라미터 제거" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="755" y="831" width="319" height="116" as="geometry"/></mxCell><mxCell id="c4_16" value="&lt;b style='font-size:12px'&gt;dispatch_next_task()  ← timer 0.5 s&lt;/b&gt;&lt;br&gt;if run_state != RUNNING: return&lt;br&gt;if active_goals: return&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ 작업이 하나라도 돌면 아무것도 안 보냄 → 두 대 동시 불가&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="937" y="1061" width="296" height="85" as="geometry"/></mxCell><mxCell id="c4_17" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;10/12: 로봇마다 보내기&lt;/b&gt;&lt;br&gt;for rid in robot_ids:&lt;br&gt;  if active_goals_by_robot[rid]: continue&lt;br&gt;  task = core.next_pending_task(rid)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="905" y="1166" width="260" height="100" as="geometry"/></mxCell><mxCell id="c4_18" value="&lt;b style='font-size:12px'&gt;task = core.next_pending_task()&lt;/b&gt;&lt;br&gt;if any(state in {ASSIGNED, RUNNING}): None&lt;br&gt;첫 PENDING (task_order 순서)&lt;br&gt;None → complete_run_if_ready()" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1185" y="1171" width="266" height="85" as="geometry"/></mxCell><mxCell id="c4_19" value="&lt;b style='font-size:12px'&gt;robot_readiness(rid) → (bool, reason)&lt;/b&gt;&lt;br&gt;status is None → False · not online → False&lt;br&gt;not accepting_tasks → False  # battery ≤ 30&lt;br&gt;state ∉ {IDLE, DOCKED} → False&lt;br&gt;&lt;font color='#5B6872'&gt;core.robots[rid].status ← on_robot_status()&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1176" y="1407" width="284" height="101" as="geometry"/></mxCell><mxCell id="c4_20" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;10/12: FACILITY 전에 마스크&lt;/b&gt;&lt;br&gt;if task.type == FACILITY_CHECK and not mask_sent[rid]:&lt;br&gt;  cells = SELECT 남은 칸 (그 섹터, 재측정 뒤)&lt;br&gt;  data = keepout_mask(cells, 0.5, origin, res, w, h)&lt;br&gt;  # Dock 반경 0.6 m 칸 제외 · 남은 칸 → Alert KEEPOUT&lt;br&gt;  pub[rid].publish(OccupancyGrid)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1419" y="1649" width="334" height="132" as="geometry"/></mxCell><mxCell id="c4_21" value="&lt;b style='font-size:12px'&gt;send_task(task_id, rid)&lt;/b&gt;&lt;br&gt;goal = ExecuteTask.Goal(task_id, run_id, type, priority,&lt;br&gt;   waypoints=[to_pose_stamped(w)], target_ref)&lt;br&gt;&lt;font color='#5B6872'&gt;frame &amp;#x27;map&amp;#x27; · q = (0, 0, sin(yaw/2), cos(yaw/2))&lt;/font&gt;&lt;br&gt;core.assign_task → ASSIGNED · send_goal_async" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1053" y="1664" width="346" height="101" as="geometry"/></mxCell><mxCell id="c4_22" value="&lt;b style='font-size:12px'&gt;on_goal_response(future)&lt;/b&gt;&lt;br&gt;if exception: finish_task(FAILED, &amp;#x27;SEND_FAILED&amp;#x27;)&lt;br&gt;if not accepted: finish_task(FAILED, &amp;#x27;GOAL_REJECTED&amp;#x27;)&lt;br&gt;else: active_goals[task_id] = gh; start_task → RUNNING&lt;br&gt;if ESTOPPED or CANCELED: cancel_goal_async()" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1503" y="1286" width="340" height="101" as="geometry"/></mxCell><mxCell id="c4_23" value="&lt;b style='font-size:12px'&gt;on_task_feedback()&lt;/b&gt;&lt;br&gt;core.update_task_progress(task_id, fb.progress)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1919" y="1423" width="294" height="53" as="geometry"/></mxCell><mxCell id="c4_24" value="&lt;b style='font-size:12px'&gt;on_task_result(future) → finish_task(ok, reason)&lt;/b&gt;&lt;br&gt;ok → SUCCEEDED, progress 1.0&lt;br&gt;reason.upper() == &amp;#x27;BLOCKED&amp;#x27; → BLOCKED  (E1 WARN)&lt;br&gt;else → FAILED  (TASK_FAILED ERROR)&lt;br&gt;REINSPECTION ok → Alert &amp;#x27;REINSPECTION_DONE&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1997" y="1528" width="355" height="101" as="geometry"/></mxCell><mxCell id="c4_25" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;10/12: 재측정 결과 → DB&lt;/b&gt;&lt;br&gt;median, n = result.rssi_median, result.n_samples  # v0.2.10&lt;br&gt;INSERT precise_measures · UPDATE 칸 상태&lt;br&gt;if n == 0 or median &amp;lt; −72: 남음 → Alert KEEPOUT (사람 확인)&lt;br&gt;else: 해제" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1880" y="1801" width="364" height="116" as="geometry"/></mxCell><mxCell id="c4_26" value="&lt;b style='font-size:12px'&gt;complete_run_if_ready()&lt;/b&gt;&lt;br&gt;if RUNNING and all_tasks_terminal():&lt;br&gt;  # 모든 task ∈ {SUCCEEDED, BLOCKED, FAILED}&lt;br&gt;  run_state = COMPLETED → Alert &amp;#x27;RUN_COMPLETED&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2083" y="1649" width="300" height="85" as="geometry"/></mxCell><mxCell id="c4_27" value="&lt;b style='font-size:12px'&gt;on_candidate(msg: Candidate)&lt;/b&gt;&lt;br&gt;if source != SOURCE_NETWORK: return&lt;br&gt;if run_id != core.run_id or IDLE: return&lt;br&gt;if candidate_id in seen: return" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1832" y="695" width="254" height="85" as="geometry"/></mxCell><mxCell id="c4_28" value="&lt;b style='font-size:12px'&gt;core.reopen_run(); create_task(&lt;/b&gt;&lt;br&gt;  f&amp;#x27;run-{id}-reinspect-{cid}&amp;#x27;, REINSPECTION, priority=10,&lt;br&gt;  waypoints=(Waypoint(msg.x, msg.y, msg.yaw),),&lt;br&gt;  preferred_robot_id = survey_robot_id)&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ 10/12: 그 칸이 속한 섹터의 로봇으로&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1783" y="846" width="352" height="101" as="geometry"/></mxCell><mxCell id="c4_29" value="&lt;b style='font-size:12px'&gt;on_inspection_result(msg: InspectionResult)&lt;/b&gt;&lt;br&gt;if run_id != core.run_id or 중복 key: return&lt;br&gt;NORMAL → Alert INFO &amp;#x27;INSPECTION_NORMAL&amp;#x27;&lt;br&gt;UNCONFIRMED → Alert WARN &amp;#x27;E6&amp;#x27;&lt;br&gt;그 외 → Alert ERROR &amp;#x27;CONFIRMED&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1498" y="687" width="314" height="101" as="geometry"/></mxCell><mxCell id="c4_30" value="&lt;b style='font-size:12px'&gt;on_estop()  /inspection/estop&lt;/b&gt;&lt;br&gt;if run_state != RUNNING: success False&lt;br&gt;core.estop(): ASSIGNED·RUNNING → CANCELED&lt;br&gt;for gh in active_goals: cancel_goal_async()  → Alert E7" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3593" y="480" width="346" height="85" as="geometry"/></mxCell><mxCell id="c4_31" value="&lt;b style='font-size:12px'&gt;on_resume()  /inspection/resume&lt;/b&gt;&lt;br&gt;CANCELED → requeue → PENDING · RUNNING" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2975" y="480" width="255" height="53" as="geometry"/></mxCell><mxCell id="c4_32" value="&lt;b style='font-size:12px'&gt;on_reassign(Reassign)&lt;/b&gt;&lt;br&gt;PENDING 이고 preferred == from 이며&lt;br&gt;to ∈ allowed_robot_ids 인 작업만 옮김 → moved_tasks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3250" y="480" width="323" height="69" as="geometry"/></mxCell><mxCell id="c4_33" value="&lt;b style='font-size:12px'&gt;publish_alert(level, code, robot_id, ref, message)&lt;/b&gt;&lt;br&gt;&lt;font color='#5B6872'&gt;위 상자들의 Alert 코드가 모두 여기로 (E1·E3·E6·E7·CANDIDATE·CONFIRMED·RUN_*)&lt;/font&gt;&lt;br&gt;Alert(stamp, level: uint8, code: str, robot_id, ref, message, delayed=False)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2448" y="894" width="461" height="69" as="geometry"/></mxCell><mxCell id="c4_34" value="&lt;font color='#2F5D7C' style='font-size:9px'&gt;다른 노드 (1번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;mission_executor ×2&lt;/b&gt;&lt;br&gt;/robot4 · /robot3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="351" y="418" width="159" height="68" as="geometry"/></mxCell><mxCell id="c4_35" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;다른 노드 (5·6번 시트)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;관제 웹 → ros_bridge&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1062" y="92" width="162" height="52" as="geometry"/></mxCell><mxCell id="c4_36" value="&lt;font color='#8A6D1F' style='font-size:9px'&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;zones.yaml&lt;/b&gt;&lt;br&gt;zones[]: id · robot · dock · polygon · spacing 0.5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="684" y="203" width="314" height="68" as="geometry"/></mxCell><mxCell id="c4_37" value="&lt;font color='#8A6D1F' style='font-size:9px'&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;facilities.yaml&lt;/b&gt;&lt;br&gt;facilities[]: id · kind · view{x,y,yaw}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="362" width="250" height="68" as="geometry"/></mxCell><mxCell id="c4_38" value="&lt;font color='#8A6D1F' style='font-size:9px'&gt;다른 노드&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;PostgreS