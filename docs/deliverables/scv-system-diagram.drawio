tSample · 1 Hz × 2대" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="86" y="662" width="208" height="68" as="geometry"/></mxCell><mxCell id="c5_8" value="&lt;font color='#2F5D7C' style='font-size:9px'&gt;mission_executor&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;IF-12 {ns}/status&lt;/b&gt;&lt;br&gt;scv_msgs/RobotStatus · 1 Hz × 2대" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="75" y="838" width="219" height="68" as="geometry"/></mxCell><mxCell id="c5_9" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;inspection_manager&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;IF-16 /inspection/alerts&lt;/b&gt;&lt;br&gt;scv_msgs/Alert" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="108" y="926" width="186" height="68" as="geometry"/></mxCell><mxCell id="c5_10" value="&lt;font color='#8E5600' style='font-size:9px'&gt;detection_alert&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;IF-19 {ns}/inspect/result&lt;/b&gt;&lt;br&gt;scv_msgs/InspectionResult (+ JPEG)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8EDDB;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="74" y="574" width="220" height="68" as="geometry"/></mxCell><mxCell id="c5_11" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;inspection_manager (관제 API 호출)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;작업·순찰 변화&lt;/b&gt;&lt;br&gt;start_run · create_task · assign · finish" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="32" y="750" width="262" height="68" as="geometry"/></mxCell><mxCell id="c5_12" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;inspection_manager (관제 API 호출)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;후보·재측정&lt;/b&gt;&lt;br&gt;Candidate · REINSPECTION 결과 · 결론" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="65" y="310" width="229" height="68" as="geometry"/></mxCell><mxCell id="c5_13" value="&lt;font color='#0B7A84' style='font-size:9px'&gt;network_map_engine (HTTP POST)&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;칸 맵&lt;/b&gt;&lt;br&gt;[{ix, iy, center, median, state}]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2F3;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="486" width="214" height="68" as="geometry"/></mxCell><mxCell id="c5_14" value="&lt;font color='#6B7780' style='font-size:9px'&gt;브라우저&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;사용자 조작&lt;/b&gt;&lt;br&gt;로그인 · 버튼 · 확정 이상 확인 · 설정" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F2F4;strokeColor=#6B7780;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="67" y="398" width="227" height="68" as="geometry"/></mxCell><mxCell id="c5_15" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_sample(m: NetSample)&lt;/b&gt;&lt;br&gt;if m.seq != last_seq[rid] + 1 and not m.resent:&lt;br&gt;    call {ns}/survey/sync(run_id, from_seq=last+1)&lt;br&gt;cell_id = SELECT grid_cells WHERE ix, iy (0.5 m)&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ net_samples 에 detected 열이 없음 · rssi_dbm NOT NULL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="597" y="678" width="335" height="116" as="geometry"/></mxCell><mxCell id="c5_16" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_status(m: RobotStatus)&lt;/b&gt;&lt;br&gt;redis.set(f&amp;#x27;robot:{rid}:state&amp;#x27;, json, ex=30)&lt;br&gt;INSERT robot_status_log (1 Hz, PK robot_id·ts)&lt;br&gt;키 만료 알림(expired) → E3 · source=&amp;#x27;control&amp;#x27;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="636" y="966" width="289" height="100" as="geometry"/></mxCell><mxCell id="c5_17" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_alert(a: Alert)&lt;/b&gt;&lt;br&gt;event_uid = f&amp;#x27;{rid}-r{run}-e{n}&amp;#x27; | &amp;#x27;control-&amp;lt;uuid&amp;gt;&amp;#x27;&lt;br&gt;level: 0→info · 1→warn · 2→error" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="609" y="1086" width="317" height="84" as="geometry"/></mxCell><mxCell id="c5_18" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_inspection(r: InspectionResult)&lt;/b&gt;&lt;br&gt;inspection_uid = uuid4()&lt;br&gt;final = normal | abnormal | unconfirmed (verdict 로)&lt;br&gt;r.image.data → 파일 scv_media/{object_key} · sha256" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="606" y="558" width="322" height="100" as="geometry"/></mxCell><mxCell id="c5_19" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_task_event(ev)&lt;/b&gt;&lt;br&gt;start_run → INSERT runs(status=&amp;#x27;running&amp;#x27;)&lt;br&gt;create → INSERT tasks(status=&amp;#x27;PENDING&amp;#x27;)&lt;br&gt;assign → UPDATE status=&amp;#x27;ACTIVE&amp;#x27;, assigned_at&lt;br&gt;result ok → &amp;#x27;DONE&amp;#x27; · fail → scv_fail_task(id, reason)&lt;br&gt;run 끝 → UPDATE runs status=&amp;#x27;done&amp;#x27;, ended_at" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="593" y="814" width="341" height="132" as="geometry"/></mxCell><mxCell id="c5_20" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_candidate_event(ev)&lt;/b&gt;&lt;br&gt;새 후보 → INSERT candidates(status=&amp;#x27;OPEN&amp;#x27;)&lt;br&gt;REINSPECTION 배정 → UPDATE &amp;#x27;REINSPECTING&amp;#x27;, reinspect_task_id&lt;br&gt;재측정 결과 → INSERT precise_measures&lt;br&gt;결론 → UPDATE &amp;#x27;CLOSED&amp;#x27;, outcome · CONFIRMED → INSERT findings" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="564" y="62" width="385" height="116" as="geometry"/></mxCell><mxCell id="c5_21" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_cell_map(cells)&lt;/b&gt;&lt;br&gt;UPSERT 칸 상태 (섹터 · median · state)&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;⚠ 지금 스키마에 칸 상태 열 없음 → 10/13 추가&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="636" y="334" width="240" height="84" as="geometry"/></mxCell><mxCell id="c5_22" value="&lt;font color='#9A6B00' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;on_user_action(req, session)&lt;/b&gt;&lt;br&gt;로그인 → SELECT users · bcrypt 비교&lt;br&gt;확정 이상 확인 (admin) → UPDATE findings status=&amp;#x27;acked&amp;#x27;&lt;br&gt;설정 (admin) → UPDATE settings (updated_at 트리거)&lt;br&gt;보고서 → 파일 생성 → INSERT reports" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4D1;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="586" y="198" width="340" height="116" as="geometry"/></mxCell><mxCell id="c5_23" value="&lt;font color='#2B6A55' style='font-size:9px'&gt;설계 · 아직 코드 없음&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;정리 (하루 한 번)&lt;/b&gt;&lt;br&gt;photo_retention_days(30) 지난 정상 판정 사진&lt;br&gt;→ DELETE media + 파일 삭제&lt;br&gt;&lt;font color='#5B6872'&gt;운영 기록(runs·tasks·events)은 지우지 않음&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="679" y="438" width="270" height="100" as="geometry"/></mxCell><mxCell id="c5_24" value="&lt;b style='font-size:12px'&gt;net_samples&lt;/b&gt;&lt;br&gt;C: INSERT … ON CONFLICT (robot_id, run_id, seq)" style="shape=cylinder3;boundedLbl=1;size=6;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="682" width="300" height="63" as="geometry"/></mxCell><mxCell id="c5_25" value="&lt;b style='font-size:12px'&gt;robot_status_log&lt;/b&gt;&lt;br&gt;C: INSERT 1 Hz" style="shape=cylinder3;boundedLbl=1;size=6;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="864" width="132" height="63" as="geometry"/></mxCell><mxCell id="c5_26" value="&lt;b style='font-size:12px'&gt;robot_events&lt;/b&gt;&lt;br&gt;C: INSERT … ON CONFLICT (event_uid)" style="shape=cylinder3;boundedLbl=1;size=6;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" y="947" width="231" height="63" as="geometry"/></mxCell><mxCell id="c5_27" value="&lt;b style='font-size:12px'&gt;inspections · media&lt;/b&gt;&lt;br&gt;C: INSERT (inspection_uid · object_key)&lt;br&gt;D: media 30일 지난 정상" style="shape=cylinder3;boundedLbl=1;size=6;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7DF;strokeColor=#8A6D1F;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1515" 