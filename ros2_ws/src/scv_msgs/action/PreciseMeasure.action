# IF-04 {ns}/survey/precise · mission_executor(로봇 PC) → rssi_scanner(RPi)
# 정지한 채 duration_s 동안 반복 스캔한다 (재검증·회피 경계 재측정).
uint16 duration_s               # 10~15초 (기본 15)
---
float32 rssi_median
float32 rssi_iqr
uint16  n_samples               # 검출 수 (기존 필드 유지)
uint16  n_total                 # 검출 + 미검출 시도
uint16  n_missed
float32 rssi_mean               # n_samples=0이면 사용하지 않음
float32 duration_s
bool measurement_valid
string measurement_reason
---
uint16 elapsed_s
